@* Adding or editing a field of study. The level is chosen once - semesters of everyone's
   studies depend on it - so editing shows it as text. Saves by itself; closes with the whole
   structure. *@
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <label class="field-label" for="field-name">Nazwa</label>
        <MudTextField @bind-Value="_form.Name" @bind-Value:after="OnFieldChanged" InputId="field-name"
                      MaxLength="FieldOfStudyForm.MaxNameLength" Placeholder="np. Informatyka"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                      Error="_errors.Has(nameof(FieldOfStudyForm.Name))"
                      ErrorText="@_errors.For(nameof(FieldOfStudyForm.Name))" />

        @if (Field is null)
        {
            <label class="field-label" for="field-level">Poziom studiów</label>
            <MudSelect T="StudyLevelOption" @bind-Value="_form.Level" @bind-Value:after="OnFieldChanged"
                       InputId="field-level" ToStringFunc="LevelText" Placeholder="Wybierz"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                       Error="_errors.Has(nameof(FieldOfStudyForm.Level))"
                       ErrorText="@_errors.For(nameof(FieldOfStudyForm.Level))">
                @foreach (var level in Enum.GetValues<StudyLevelOption>())
                {
                    <MudSelectItem Value="level">@LevelText(level)</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudText Class="field-label">Poziom studiów</MudText>
            <MudText Class="mb-4">@Field.LevelText</MudText>
        }

        <label class="field-label" for="field-faculty">Wydział</label>
        <MudSelect T="int" @bind-Value="_form.FacultyId" @bind-Value:after="OnFieldChanged"
                   InputId="field-faculty" ToStringFunc="FacultyName" Placeholder="Wybierz"
                   Variant="Variant.Outlined" Margin="Margin.Dense"
                   Error="_errors.Has(nameof(FieldOfStudyForm.FacultyId))"
                   ErrorText="@_errors.For(nameof(FieldOfStudyForm.FacultyId))">
            @* Switched-on faculties - and the field's own one, wherever it is *@
            @foreach (var faculty in Faculties.Where(f => f.IsActive || f.Id == Field?.FacultyId))
            {
                <MudSelectItem Value="faculty.Id">@faculty.Name (@faculty.Code)</MudSelectItem>
            }
        </MudSelect>
        }

        @* Moving decides who sees the applications - worth saying before it happens *@
        @if (Field is not null && _form.FacultyId != Field.FacultyId)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                Wnioski studentów tego kierunku, w toku i zakończone, przejdą do dziekanatu wydziału
                @FacultyText(_form.FacultyId). Pracownicy obecnego wydziału przestaną je widzieć.
            </MudAlert>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving"
                   OnClick="SaveAsync">
            @(_saving ? "Zapisywanie..." : Field is null ? "Dodaj" : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // Null for a new field of study
    [Parameter]
    public FieldOfStudyItem? Field { get; set; }

    [Parameter]
    public IReadOnlyList<FacultyItem> Faculties { get; set; } = [];

    // A new field: the faculty whose "Dodaj kierunek" was clicked
    [Parameter]
    public int FacultyId { get; set; }

    private readonly FieldOfStudyForm _form = new();
    private readonly FormErrors _errors = new();
    private string? _error;
    private bool _saving;
    private bool _attempted;

    protected override void OnInitialized()
    {
        if (Field is null)
        {
            _form.FacultyId = FacultyId;
            return;
        }

        _form.Name = Field.Name;
        _form.Level = Field.Level;
        _form.FacultyId = Field.FacultyId;
        // Switched on and off on the page itself - kept as it is
        _form.IsActive = Field.IsActive;
    }

    private static string LevelText(StudyLevelOption level) => level switch
    {
        StudyLevelOption.FirstCycle => "studia pierwszego stopnia",
        StudyLevelOption.SecondCycle => "studia drugiego stopnia",
        StudyLevelOption.LongCycle => "jednolite studia magisterskie",
        _ => ""
    };

    // "Wydział Informatyki (WI)" in the field, the code alone in the warning
    private string FacultyName(int id) =>
        Faculties.FirstOrDefault(f => f.Id == id) is { } faculty ? $"{faculty.Name} ({faculty.Code})" : "";

    private string FacultyText(int id) => Faculties.FirstOrDefault(f => f.Id == id)?.Code ?? "";

    private void OnFieldChanged()
    {
        _error = null;
        if (_attempted)
            _errors.Validate(_form);
    }

    private async Task SaveAsync()
    {
        _attempted = true;
        _error = null;

        if (!_errors.Validate(_form))
            return;

        _saving = true;
        var result = Field is null
            ? await Api.AddFieldOfStudyAsync(_form)
            : await Api.UpdateFieldOfStudyAsync(Field.Id, _form);
        _saving = false;

        if (!result.IsSuccess)
        {
            _errors.Set(result.Error.FieldErrors);
            _error = result.Error.Message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(result.Value));
    }

    private void Cancel() => MudDialog.Cancel();

    // The structure after saving, or null when the dialog was cancelled
    public static async Task<IReadOnlyList<FacultyItem>?> ShowAsync(IDialogService dialogs,
        IReadOnlyList<FacultyItem> faculties, FieldOfStudyItem? field, int facultyId)
    {
        var parameters = new DialogParameters<FieldOfStudyDialog>
        {
            { d => d.Field, field },
            { d => d.Faculties, faculties },
            { d => d.FacultyId, facultyId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await dialogs.ShowAsync<FieldOfStudyDialog>(
            field is null ? "Dodaj kierunek" : "Edytuj kierunek", parameters, options);
        var result = await dialog.Result;

        return result is { Canceled: false, Data: IReadOnlyList<FacultyItem> structure } ? structure : null;
    }
}