@* Editing one kind of application. Saves by itself, so errors stay in the dialog next to their
   fields; closes with the kind as the server has it now. *@
@inject ApiClient Api

<MudDialog>
    <DialogContent>
        <label class="field-label" for="type-name">Nazwa</label>
        <MudTextField @bind-Value="_form.Name" @bind-Value:after="OnFieldChanged" InputId="type-name"
                      MaxLength="ApplicationTypeForm.MaxNameLength"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                      Error="_errors.Has(nameof(ApplicationTypeForm.Name))"
                      ErrorText="@_errors.For(nameof(ApplicationTypeForm.Name))" />

        <label class="field-label" for="type-description">Opis dla studenta</label>
        <MudTextField @bind-Value="_form.Description" @bind-Value:after="OnFieldChanged"
                      InputId="type-description" Lines="4" AutoGrow="true"
                      MaxLength="ApplicationTypeForm.MaxDescriptionLength" Counter="ApplicationTypeForm.MaxDescriptionLength"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4"
                      Error="_errors.Has(nameof(ApplicationTypeForm.Description))"
                      ErrorText="@_errors.For(nameof(ApplicationTypeForm.Description))" />

        <label class="field-label" for="type-attachments">Limit załączników</label>
        <MudNumericField T="int" @bind-Value="_form.MaxAttachments" @bind-Value:after="OnFieldChanged"
                         InputId="type-attachments" Min="0" Max="ApplicationTypeForm.MaxAttachmentsLimit"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="type-attachments mb-2"
                         Error="_errors.Has(nameof(ApplicationTypeForm.MaxAttachments))"
                         ErrorText="@_errors.For(nameof(ApplicationTypeForm.MaxAttachments))" />

        <MudSwitch T="bool" @bind-Value="_form.RequiresDeanDecision" Color="Color.Primary"
                   Label="Wymaga decyzji prodziekana" />
        <MudSwitch T="bool" @bind-Value="_form.IsActive" Color="Color.Primary"
                   Label="Włączony - studenci mogą składać nowe wnioski" />

        @* What the change means for applications already submitted or begun *@
        @if (Type.IsActive && !_form.IsActive)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                Studenci nie złożą nowych wniosków tego rodzaju, także niedokończonych. Wnioski w toku
                zostaną rozpatrzone do końca.
            </MudAlert>
        }
        @if (_form.MaxAttachments != Type.MaxAttachments || _form.RequiresDeanDecision != Type.RequiresDeanDecision)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                Limit załączników i decyzja prodziekana dotyczą tylko nowych wniosków - złożone
                zachowują ustawienia z chwili złożenia.
            </MudAlert>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="_saving"
                   OnClick="SaveAsync">
            @(_saving ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public ApplicationTypeDetails Type { get; set; } = null!;

    private ApplicationTypeForm _form = new();
    private readonly FormErrors _errors = new();
    private string? _error;
    private bool _saving;
    private bool _attempted;

    protected override void OnInitialized() => _form = ApplicationTypeForm.From(Type);

    private void OnFieldChanged()
    {
        _error = null;
        if (_attempted)
            _errors.Validate(_form);
    }

    private async Task SaveAsync()
    {
        _attempted = true;
        _error = null;

        if (!_errors.Validate(_form))
            return;

        _saving = true;
        var result = await Api.UpdateApplicationTypeAsync(Type.Id, _form);
        _saving = false;

        if (!result.IsSuccess)
        {
            _errors.Set(result.Error.FieldErrors);
            _error = result.Error.Message;
            return;
        }

        MudDialog.Close(DialogResult.Ok(result.Value));
    }

    private void Cancel() => MudDialog.Cancel();

    // The kind after saving, or null when the dialog was cancelled
    public static async Task<ApplicationTypeDetails?> ShowAsync(IDialogService dialogs,
        ApplicationTypeDetails type)
    {
        var parameters = new DialogParameters<ApplicationTypeDialog> { { d => d.Type, type } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await dialogs.ShowAsync<ApplicationTypeDialog>(type.Name, parameters, options);
        var result = await dialog.Result;

        return result is { Canceled: false, Data: ApplicationTypeDetails saved } ? saved : null;
    }
}