@inherits LayoutComponentBase
@inject CookieAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject MyApplicationCounts Counts
@implements IDisposable

<MudLayout>
    <MudAppBar Elevation="0">
        <AuthorizeView Context="auth">
            @if (HasMenu(auth.User))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               aria-label="Menu" OnClick="ToggleDrawer" />
            }
        </AuthorizeView>
        <a href="./" class="d-flex" aria-label="UniFlow - strona startowa">
            <img src="images/uniflow-logo.svg" alt="UniFlow" class="appbar-logo" />
        </a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         AriaLabel="Menu użytkownika" Class="ml-4">
                    <ActivatorContent Context="menu">
                        <MudButton Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                   OnClick="menu.ToggleAsync">
                            <MudAvatar Size="Size.Small" Class="user-avatar">
                                @Initials(context.User.Identity?.Name)
                            </MudAvatar>
                            <span class="user-name">@context.User.Identity?.Name</span>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body1"><b>@context.User.Identity?.Name</b></MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @context.User.FindFirst(ClaimTypes.Email)?.Value
                            </MudText>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">
                            Wyloguj
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="login" Color="Color.Inherit">Zaloguj się</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* Only when there is somewhere to go - an employee or the administrator alone has one page,
       and the logo leads back to it *@
    <AuthorizeView Context="auth">
        @if (HasMenu(auth.User))
        {
            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
                       Class="border-r border-solid mud-border-lines-default">
                <MudNavMenu>
                    <AuthorizeView Roles="@($"{RoleNames.DeanOffice},{RoleNames.ViceDean}")">
                        <MudNavLink Href="review" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Inbox">
                            Wnioski do rozpatrzenia
                        </MudNavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@RoleNames.Administrator">
                        <MudNavLink Href="admin" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Outlined.AdminPanelSettings">
                            Panel administratora
                        </MudNavLink>
                    </AuthorizeView>
                    <AuthorizeView Roles="@RoleNames.Student">
                        @* All, not Prefix: "my" would also light up on "my/zakonczone" *@
                        <MudNavGroup Title="Moje wnioski" Icon="@Icons.Material.Outlined.FolderOpen" Expanded="true">
                            <MudNavLink Href="my" Match="NavLinkMatch.All">
                                <span class="nav-label">W toku<span class="nav-count">@Counts.InProgress</span></span>
                            </MudNavLink>
                            <MudNavLink Href="my/zakonczone" Match="NavLinkMatch.All">
                                <span class="nav-label">Zakończone<span class="nav-count">@Counts.Closed</span></span>
                            </MudNavLink>
                        </MudNavGroup>
                        <MudNavLink Href="new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAdd">
                            Nowy wniosek
                        </MudNavLink>
                    </AuthorizeView>
                </MudNavMenu>
            </MudDrawer>
        }
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    
    protected override async Task OnInitializedAsync()
    {
        Counts.Changed += CountsChanged;

        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.IsInRole(RoleNames.Student))
            await Counts.RefreshAsync();
    }

    private void CountsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Counts.Changed -= CountsChanged;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // A student has two pages to choose from; an employee or the administrator alone only one
    private static bool HasMenu(ClaimsPrincipal user) =>
        user.IsInRole(RoleNames.Student)
        || ((user.IsInRole(RoleNames.DeanOffice) || user.IsInRole(RoleNames.ViceDean))
            && user.IsInRole(RoleNames.Administrator));

    private static string Initials(string? name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpper(part[0])));

    private async Task LogoutAsync()
    {
        if (!await AuthState.LogoutAsync())
        {
            Snackbar.Add("Nie udało się wylogować. Spróbuj ponownie za chwilę.", Severity.Error);
            return;
        }

        // Full page reload: clears everything the app kept in memory about the previous user
        Navigation.NavigateTo("login", forceLoad: true);
    }
}