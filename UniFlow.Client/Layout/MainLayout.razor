@inherits LayoutComponentBase
@inject CookieAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Menu" OnClick="ToggleDrawer" />
        <img src="images/uniflow-logo.svg" alt="UniFlow" class="appbar-logo" />
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         AriaLabel="Menu użytkownika" Class="ml-4">
                    <ActivatorContent Context="menu">
                        <MudButton Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                   OnClick="menu.ToggleAsync">
                            <MudAvatar Size="Size.Small" Class="user-avatar">
                                @Initials(context.User.Identity?.Name)
                            </MudAvatar>
                            <span class="user-name">@context.User.Identity?.Name</span>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.body1"><b>@context.User.Identity?.Name</b></MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @context.User.FindFirst(ClaimTypes.Email)?.Value
                            </MudText>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">
                            Wyloguj
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="login" Color="Color.Inherit">Zaloguj się</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
               Class="border-r border-solid mud-border-lines-default">
                <MudNavMenu>
            <AuthorizeView Roles="@RoleNames.Student">
                <MudNavLink Href="new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAdd">
                    Nowy wniosek
                </MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
        
    // "Jan Zieliński" -> "JZ"
    private static string Initials(string? name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpper(part[0])));


    private async Task LogoutAsync()
    {
        if (!await AuthState.LogoutAsync())
        {
            Snackbar.Add("Nie udało się wylogować. Spróbuj ponownie za chwilę.", Severity.Error);
            return;
        }

        // Full page reload: clears everything the app kept in memory about the previous user
        Navigation.NavigateTo("login", forceLoad: true);
    }
}