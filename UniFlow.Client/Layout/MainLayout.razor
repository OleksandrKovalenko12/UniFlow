@inherits LayoutComponentBase
@inject CookieAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Menu" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">UniFlow</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu Label="@context.User.Identity?.Name" Color="Color.Inherit"
                         StartIcon="@Icons.Material.Outlined.AccountCircle"
                         EndIcon="@Icons.Material.Filled.ArrowDropDown"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         AriaLabel="Menu użytkownika">
                    <MudText Typo="Typo.body2" Class="px-4 py-2 mud-text-secondary">
                        @context.User.FindFirst(ClaimTypes.Email)?.Value
                    </MudText>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">
                        Wyloguj
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="login" Color="Color.Inherit">Zaloguj się</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always"
               Class="border-r border-solid mud-border-lines-default">
        <MudNavMenu>
            <MudNavLink Href="new" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.NoteAdd">
                Nowy wniosek
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync()
    {
        if (!await AuthState.LogoutAsync())
        {
            Snackbar.Add("Nie udało się wylogować. Spróbuj ponownie za chwilę.", Severity.Error);
            return;
        }

        // Full page reload: clears everything the app kept in memory about the previous user
        Navigation.NavigateTo("login", forceLoad: true);
    }
}