@* One number on the start page, e.g. "Do poprawy 2". Attention: something waits for this
   user - shown in the app's colour. Href: the tile leads to the list behind the number. *@

@if (Href is null)
{
    <div class="@CssClass">@Content</div>
}
else
{
    <a href="@Href" class="@CssClass">@Content</a>
}

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public int Value { get; set; }

    // A short addition under the label, e.g. "+3 od ostatniego logowania"
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Attention { get; set; }

    [Parameter]
    public string? Href { get; set; }

    private string CssClass => Attention && Value > 0 ? "welcome-stat attention" : "welcome-stat";

    private RenderFragment Content => @<text>
        <div class="welcome-stat-value">@Value</div>
        <MudText Typo="Typo.body2">@Label</MudText>
        @if (Hint is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Hint</MudText>
        }
    </text>;
}