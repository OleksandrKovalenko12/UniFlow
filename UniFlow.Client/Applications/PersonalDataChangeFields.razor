@* The fields of the personal data form - the same when the application is submitted and when
   it is corrected. The student ticks what changes; only those parts are shown, each with the old
   and the new value. Checking and saving stay with the page: it hears about every change. *@

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Co chcesz zmienić?</MudText>
    <div class="d-flex flex-column">
        <MudCheckBox T="bool" @bind-Value="Form.ChangeName" @bind-Value:after="NameTickedAsync"
                     Color="Color.Primary" Label="Imię lub nazwisko" />
        <MudCheckBox T="bool" @bind-Value="Form.ChangeAddress" @bind-Value:after="AddressTickedAsync"
                     Color="Color.Primary" Label="Adres korespondencyjny" />
        <MudCheckBox T="bool" @bind-Value="Form.ChangePhone" @bind-Value:after="ChangedAsync"
                     Color="Color.Primary" Label="Numer telefonu" />
        <MudCheckBox T="bool" @bind-Value="Form.ChangeEmail" @bind-Value:after="EmailTickedAsync"
                     Color="Color.Primary" Label="Prywatny adres e-mail" />
    </div>
    @if (Errors.Has(PersonalDataChangeForm.ChangesField))
    {
        <MudText Typo="Typo.body2" Color="Color.Error">@Errors.For(PersonalDataChangeForm.ChangesField)</MudText>
    }
</MudPaper>

@if (Form.ChangeName)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">Imię i nazwisko</MudText>
        @if (Current is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Obecnie: @Current.FirstName @Current.LastName
            </MudText>
        }
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <label class="field-label" for="new-first-name">Nowe imię</label>
                <MudTextField @bind-Value="Form.NewFirstName" @bind-Value:after="ChangedAsync"
                              InputId="new-first-name" MaxLength="PersonalDataChangeForm.MaxNameLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.NewFirstName))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.NewFirstName))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <label class="field-label" for="new-last-name">Nowe nazwisko</label>
                <MudTextField @bind-Value="Form.NewLastName" @bind-Value:after="ChangedAsync"
                              InputId="new-last-name" MaxLength="PersonalDataChangeForm.MaxNameLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.NewLastName))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.NewLastName))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <label class="field-label" for="reason">Powód zmiany</label>
                <MudSelect T="PersonalDataChangeReason" @bind-Value="Form.Reason" @bind-Value:after="ChangedAsync"
                           InputId="reason" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="ReasonLabel" Placeholder="Wybierz"
                           Error="Errors.Has(nameof(PersonalDataChangeForm.Reason))"
                           ErrorText="@Errors.For(nameof(PersonalDataChangeForm.Reason))">
                    @foreach (var reason in Enum.GetValues<PersonalDataChangeReason>())
                    {
                        <MudSelectItem Value="reason" />
                    }
                </MudSelect>
            </MudItem>
            @if (Form.Reason == PersonalDataChangeReason.Other)
            {
                <MudItem xs="12">
                    <label class="field-label" for="reason-details">Opis powodu</label>
                    <MudTextField @bind-Value="Form.ReasonDetails" @bind-Value:after="ChangedAsync"
                                  InputId="reason-details" Lines="3" Immediate="true"
                                  Counter="PersonalDataChangeForm.MaxReasonDetailsLength"
                                  MaxLength="PersonalDataChangeForm.MaxReasonDetailsLength"
                                  Variant="Variant.Outlined"
                                  Error="Errors.Has(nameof(PersonalDataChangeForm.ReasonDetails))"
                                  ErrorText="@Errors.For(nameof(PersonalDataChangeForm.ReasonDetails))" />
                </MudItem>
            }
        </MudGrid>
    </MudPaper>
}

@if (Form.ChangeAddress)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Adres korespondencyjny</MudText>
        <AddressFields Address="Form.OldAddress" Title="Dotychczasowy adres" Id="old-address"
                       Prefix="@($"{nameof(PersonalDataChangeForm.OldAddress)}.")"
                       Errors="Errors" OnChanged="OnChanged" />
        <AddressFields Address="Form.NewAddress" Title="Nowy adres" Id="new-address"
                       Prefix="@($"{nameof(PersonalDataChangeForm.NewAddress)}.")"
                       Errors="Errors" OnChanged="OnChanged" />
    </MudPaper>
}

@if (Form.ChangePhone)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Numer telefonu</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <label class="field-label" for="old-phone">Dotychczasowy numer</label>
                <MudTextField @bind-Value="Form.OldPhone" @bind-Value:after="ChangedAsync"
                              InputId="old-phone" InputType="InputType.Telephone"
                              MaxLength="20" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.OldPhone))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.OldPhone))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <label class="field-label" for="new-phone">Nowy numer</label>
                <MudTextField @bind-Value="Form.NewPhone" @bind-Value:after="ChangedAsync"
                              InputId="new-phone" InputType="InputType.Telephone" Placeholder="np. 600 123 456"
                              MaxLength="20" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.NewPhone))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.NewPhone))" />
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@if (Form.ChangeEmail)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Prywatny adres e-mail</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <label class="field-label" for="old-email">Dotychczasowy adres</label>
                <MudTextField @bind-Value="Form.OldEmail" @bind-Value:after="ChangedAsync"
                              InputId="old-email" InputType="InputType.Email"
                              MaxLength="PersonalDataChangeForm.MaxEmailLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.OldEmail))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.OldEmail))" />
            </MudItem>
            <MudItem xs="12" md="6">
                <label class="field-label" for="new-email">Nowy adres</label>
                <MudTextField @bind-Value="Form.NewEmail" @bind-Value:after="ChangedAsync"
                              InputId="new-email" InputType="InputType.Email"
                              MaxLength="PersonalDataChangeForm.MaxEmailLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(PersonalDataChangeForm.NewEmail))"
                              ErrorText="@Errors.For(nameof(PersonalDataChangeForm.NewEmail))" />
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public PersonalDataChangeForm Form { get; set; } = null!;

    [Parameter, EditorRequired]
    public FormErrors Errors { get; set; } = null!;

    // Any change of the fields
    [Parameter]
    public EventCallback OnChanged { get; set; }

    // The name and e-mail the system knows now - the name is shown as "Obecnie", the e-mail is
    // suggested as the old one; null while loading
    [Parameter]
    public CurrentPersonalData? Current { get; set; }

    // Under the file picker: the document is needed only for a new name
    public static string FilesHint(PersonalDataChangeForm form) => form.ChangeName
        ? "Wymagany dokument potwierdzający zmianę imienia lub nazwiska, np. odpis aktu małżeństwa."
        : "Przy zmianie adresu, telefonu lub e-maila załącznik nie jest potrzebny.";

    private Task ChangedAsync() => OnChanged.InvokeAsync();

    // Ticked for the first time: the current name to start from - usually only one part changes
    private Task NameTickedAsync()
    {
        if (Form.ChangeName && Current is not null
            && string.IsNullOrEmpty(Form.NewFirstName) && string.IsNullOrEmpty(Form.NewLastName))
        {
            Form.NewFirstName = Current.FirstName;
            Form.NewLastName = Current.LastName;
        }

        return ChangedAsync();
    }

    // Most students live in Poland - the country is filled in, it can be changed
    private Task AddressTickedAsync()
    {
        if (Form.ChangeAddress && Form.OldAddress.IsEmpty && Form.NewAddress.IsEmpty)
        {
            Form.OldAddress.Country = PostalAddress.DefaultCountry;
            Form.NewAddress.Country = PostalAddress.DefaultCountry;
        }

        return ChangedAsync();
    }

    // The e-mail the system knows is suggested as the old one - the student can correct it
    private Task EmailTickedAsync()
    {
        if (Form.ChangeEmail && string.IsNullOrEmpty(Form.OldEmail) && Current?.PrivateEmail is not null)
            Form.OldEmail = Current.PrivateEmail;

        return ChangedAsync();
    }

    // "zawarcie związku małżeńskiego" -> "Zawarcie związku małżeńskiego"; nothing chosen yet -> empty
    private static string ReasonLabel(PersonalDataChangeReason reason)
    {
        if (!Enum.IsDefined(reason))
            return "";

        var name = PersonalDataChangeReasonText.Name(reason);
        return char.ToUpper(name[0]) + name[1..];
    }
}