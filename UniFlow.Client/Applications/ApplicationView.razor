@* One application, as the server prepared it for this user: the same component for the dean's
   office, the vice-dean and (later) the student - only the data differ *@

<MudGrid Spacing="4">
    <MudItem xs="12" md="8">
        @* Header *@
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <div class="d-flex flex-wrap align-center gap-3 mb-1">
                <MudText Typo="Typo.h5" HtmlTag="h1">@Details.Number</MudText>
                <StatusChip Status="Details.Status" />
            </div>
            <MudText>@Details.TypeName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Złożony @DateText.Format(Details.SubmittedAt)
                @if (Details.AssignedToName is not null)
                {
                    <span> · Prowadzi: @Details.AssignedToName</span>
                }
            </MudText>
        </MudPaper>

        @* Student and studies *@
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="5">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Student</MudText>
                    <MudText><b>@Details.StudentName</b></MudText>
                    <MudText Typo="Typo.body2">nr albumu @Details.AlbumNumber</MudText>
                    @* Staff only - to ask the student instead of sending the case back *@
                    @if (Details.StudentEmail is not null)
                    {
                        <MudLink Href="@($"mailto:{Details.StudentEmail}")" Typo="Typo.body2"
                                 Class="student-email">@Details.StudentEmail</MudLink>
                    }
                    @* Staff only, and only when there is something to see - the number says so without a click *@
                    @if (Details.OtherApplications.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.FolderOpen" Class="ml-n2 mt-1"
                                   OnClick="ShowOtherApplicationsAsync">
                            Inne wnioski (@Details.OtherApplications.Count)
                        </MudButton>
                    }
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Studia</MudText>
                    <MudText><b>@Details.Studies.FieldOfStudyName</b>, @EnrollmentLabels.Details(Details.Studies)</MudText>
                    <MudText Typo="Typo.body2">@EnrollmentLabels.Faculty(Details.Studies)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* What the student asks for *@
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Treść wniosku</MudText>
            @if (Details.TypeCode == ApplicationTypeCodes.GroupChange)
            {
                <GroupChangeSummary Form="FormJson.Deserialize<GroupChangeForm>(Details.FormData)" />
            }
            else if (Details.TypeCode == ApplicationTypeCodes.PersonalDataChange)
            {
                <PersonalDataChangeSummary Form="FormJson.Deserialize<PersonalDataChangeForm>(Details.FormData)" />
            }
            else if (Details.TypeCode == ApplicationTypeCodes.DeanLeave)
            {
                <DeanLeaveSummary Form="FormJson.Deserialize<DeanLeaveForm>(Details.FormData)" />
            }
            else
            {
                <MudText Class="mud-text-secondary">Podgląd tego rodzaju wniosku nie jest jeszcze dostępny - treść jest w dokumencie PDF.</MudText>
            }
        </MudPaper>

        @* Documents and files *@
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Dokumenty</MudText>

            @foreach (var file in Current.Where(f => f.IsDocument))
            {
                <FileRow ApplicationId="Details.Id" File="file" />
            }

            <MudText Typo="Typo.subtitle2" Class="mt-3">Załączniki</MudText>
            @if (!Current.Any(f => !f.IsDocument))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Brak załączników.</MudText>
            }
            @foreach (var file in Current.Where(f => !f.IsDocument))
            {
                <FileRow ApplicationId="Details.Id" File="file" />
            }

            @* Only staff get these: nothing is deleted, older versions stay readable *@
            @if (Archived.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">Poprzednie wersje i usunięte pliki</MudText>
                @foreach (var file in Archived)
                {
                    <FileRow ApplicationId="Details.Id" File="file" />
                }
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        @Actions

        @* History, the latest change first *@
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Historia</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineAlign="TimelineAlign.Start">
                @foreach (var change in Details.History.Reverse())
                {
                    <MudTimelineItem Color="@StatusLabels.ColorOf(change.To)" Size="Size.Small">
                        <MudText Typo="Typo.subtitle2">@StatusLabels.Name(change.To)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @DateText.Format(change.ChangedAt) · @change.ChangedBy
                        </MudText>
                        @if (change.Comment is not null)
                        {
                            <div class="@(change.IsInternal ? "history-comment internal" : "history-comment")">
                                @if (change.IsInternal)
                                {
                                    <MudTooltip Text="Student jej nie widzi">
                                        <div class="d-flex align-center gap-1 mb-1">
                                            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                                            <MudText Typo="Typo.caption">Notatka wewnętrzna</MudText>
                                        </div>
                                    </MudTooltip>
                                }
                                <MudText Typo="Typo.body2" Class="pre-line">@change.Comment</MudText>
                            </div>
                        }
                    </MudTimelineItem>
                }
            </MudTimeline>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Inject]
    private IDialogService Dialogs { get; set; } = null!;

    [Parameter, EditorRequired]
    public ApplicationDetails Details { get; set; } = null!;
    
    // The application the employee started from - links in "Inne wnioski" lead back to it
    [Parameter]
    public Guid OriginId { get; set; }

    // Decision buttons of the dean's office or the vice-dean (step D.3)
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private IEnumerable<AttachmentInfo> Current => Details.Attachments.Where(f => f.ArchivedAt is null);

    private List<AttachmentInfo> Archived => Details.Attachments.Where(f => f.ArchivedAt is not null).ToList();
    
    private Task ShowOtherApplicationsAsync() =>
        OtherApplicationsDialog.ShowAsync(Dialogs, OriginId, Details.StudentName, Details.OtherApplications);
}