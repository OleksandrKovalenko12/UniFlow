@* What the student may still do with their own application *@
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Twój wniosek</MudText>

    <MudButton Variant="Variant.Outlined" Color="Color.Error" DropShadow="false" FullWidth="true"
               Disabled="_sending" OnClick="WithdrawAsync">
        Wycofaj wniosek
    </MudButton>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ApplicationDetails Details { get; set; } = null!;

    // The application after the change
    [Parameter]
    public EventCallback<ApplicationDetails> Changed { get; set; }

    private bool _sending;
    private string? _error;

    private async Task WithdrawAsync()
    {
        _error = null;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Wycofać wniosek?",
            "Wycofanego wniosku nie można przywrócić. Jeśli sprawa będzie znowu aktualna, " +
            "trzeba złożyć nowy wniosek.",
            yesText: "Wycofaj", cancelText: "Anuluj");

        if (confirmed != true)
            return;

        _sending = true;
        var result = await Api.WithdrawAsync(Details.Id);
        _sending = false;

        if (!result.IsSuccess)
        {
            _error = result.Error.Message;
            return;
        }

        Snackbar.Add("Wniosek wycofany.", Severity.Success);
        await Changed.InvokeAsync(result.Value);
    }
}