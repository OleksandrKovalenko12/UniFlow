@* Files for an application: chosen in the form, sent right after the application is submitted *@

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6">Załączniki</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        @Hint Najwyżej @FileCount(MaxFiles) do 10 MB: PDF, DOCX, ODT, JPG, PNG, WebP.
    </MudText>

    @foreach (var file in Files)
    {
        <div class="attachment-row">
            <MudIcon Icon="@IconFor(file.Name)" Size="Size.Small" Class="mud-text-secondary" />
            <span class="attachment-name" title="@file.Name">@file.Name</span>
            <span class="attachment-size mud-text-secondary">@FileSizeText.Format(file.Size)</span>
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                           aria-label="@($"Usuń plik {file.Name}")" OnClick="() => RemoveAsync(file)" />
        </div>
    }

    @foreach (var message in _messages)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">@message</MudText>
    }

        @* The hidden file input must stay on the page while the files are read -
       the browser reads them through it *@
    @if (_reading || Files.Count < MaxFiles)
    {
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="AddAsync"
                       Accept="@Accept" MaximumFileCount="MaxSelection">
            <CustomContent>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-1"
                           StartIcon="@Icons.Material.Outlined.AttachFile"
                           Disabled="_reading" OnClick="@context.OpenFilePickerAsync">
                    @(_reading ? "Wczytywanie..." : "Dodaj plik")
                </MudButton>
            </CustomContent>
            @* Our own list is above - no chips from MudBlazor *@
            <SelectedTemplate />
        </MudFileUpload>
    }
</MudPaper>

@code {
    // Kept by the page, so the files survive "Zmień" and are there when the form is sent
    [Parameter, EditorRequired]
    public List<PickedFile> Files { get; set; } = null!;

    [Parameter]
    public int MaxFiles { get; set; }

    // What could be attached to this type of application
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    // More files picked in one go are not read at all
    private const int MaxSelection = 20;

    private static readonly string Accept = string.Join(",", AttachmentRules.Extensions);

    private readonly List<string> _messages = [];
    private bool _reading;

    private async Task AddAsync(IReadOnlyList<IBrowserFile>? picked)
    {
        _messages.Clear();
        if (picked is null || picked.Count == 0)
            return;

        _reading = true;

        foreach (var file in picked)
        {
            if (Files.Count >= MaxFiles)
            {
                _messages.Add($"Można dodać najwyżej {FileCount(MaxFiles)}.");
                break;
            }

            var problem = Check(file);
            if (problem is not null)
            {
                _messages.Add(problem);
                continue;
            }

            try
            {
                // Read now: the browser forgets this file when the student picks the next ones
                await using var stream = file.OpenReadStream(AttachmentRules.MaxSizeBytes);
                using var content = new MemoryStream((int)file.Size);
                await stream.CopyToAsync(content);

                Files.Add(new PickedFile(file.Name, content.ToArray()));
            }
            catch (Exception exception) when (exception is IOException or JSException)
            {
                _messages.Add($"Nie udało się wczytać pliku {file.Name}.");
            }
        }

        _reading = false;
        await OnChanged.InvokeAsync();
    }

    // The same rules the server checks - here the student learns at once
    private string? Check(IBrowserFile file)
    {
        if (!AttachmentRules.IsAllowedExtension(file.Name))
            return $"Plik {file.Name}: ten rodzaj pliku nie jest obsługiwany.";

        if (file.Size < 1 || file.Size > AttachmentRules.MaxSizeBytes)
            return $"Plik {file.Name} jest pusty albo większy niż 10 MB.";

        if (Files.Any(f => f.Name == file.Name && f.Size == file.Size))
            return $"Plik {file.Name} jest już dodany.";

        return null;
    }

    private async Task RemoveAsync(PickedFile file)
    {
        Files.Remove(file);
        _messages.Clear();
        await OnChanged.InvokeAsync();
    }

    private static string IconFor(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".pdf" => Icons.Material.Outlined.PictureAsPdf,
            ".jpg" or ".jpeg" or ".png" or ".webp" => Icons.Material.Outlined.Image,
            _ => Icons.Material.Outlined.Description
        };

    // 1 plik, 2-4 pliki, 5 plików (but 12-14 plików)
    private static string FileCount(int count) =>
        count == 1 ? "1 plik"
        : count % 10 is >= 2 and <= 4 && count % 100 is < 12 or > 14 ? $"{count} pliki"
        : $"{count} plików";
}