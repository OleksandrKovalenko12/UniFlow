@typeparam TForm where TForm : class, new()
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject MyApplicationCounts Counts
@implements IDisposable

@* A new application of any kind. The page of a kind gives its route, title, fields and rules;
   the rest is the same for all: the draft, the files, the studies, sending and leaving.
   The form is saved as a draft, so leaving is safe - it asks only when the last changes
   could not be saved yet or files are still being sent. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="HasUnsavedChanges" />

@* Back to the page the form was opened from. No "Zapisz" button: the draft saves itself,
   leaving is enough. *@
<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl" Class="mb-2 ml-n2">
    Wróć
</MudButton>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">@Title</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="new">Wróć do listy wniosków</MudButton>
}
else if (_enrollment is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_submitted is not null)
{
    <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Outlined="true" Style="text-align: center">
        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Style="font-size: 3rem" />
        <MudText Typo="Typo.h6" Class="mt-2">Wniosek złożony</MudText>
        <MudText Class="mud-text-secondary mt-4">Numer wniosku</MudText>
        <MudLink Href="@($"applications/{_submitted.Id}")" Typo="Typo.h4" Class="mb-6">
            <b>@_submitted.Number</b>
        </MudLink>

        <div class="d-flex flex-wrap justify-center gap-2 mb-4">
            @* target="_blank" and download: the router lets these links through to the server *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Outlined.Visibility"
                       Href="@ApiClient.DocumentUrl(_submitted.Id, inline: true)" Target="_blank">
                Podgląd PDF
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Href="@ApiClient.DocumentUrl(_submitted.Id, inline: false)" download="">
                Pobierz
            </MudButton>
        </div>

        <MudText Typo="Typo.body2" Class="mud-text-secondary">Dziekanat sprawdzi wniosek.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="my" Class="mt-4">
            Moje wnioski
        </MudButton>
    </MudPaper>
}
else if (Blocking is not null)
{
    @* Reached by "wstecz" after submitting, an old link or "Zmień" - the server would refuse anyway *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Masz już wniosek @About w toku na tych studiach: <b>@Blocking.Number</b>.
        Nowy złożysz, gdy ten zostanie rozpatrzony albo wycofany.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               Href="@($"applications/{Blocking.Id}")">
        Otwórz wniosek
    </MudButton>
}
else if (_typeInactive)
{
    @* The administrator has switched the kind off - e.g. a draft from before. The server would
       refuse it, so the form is not shown at all. *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Wniosków @About nie można już składać. Niedokończony wniosek możesz usunąć na liście
        „Moje wnioski”.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Href="my">
        Moje wnioski
    </MudButton>
}
else
{
    <MudPaper Class="pa-4 mb-4 d-flex align-center gap-4" Elevation="0" Outlined="true">
        <div class="flex-grow-1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Studia</MudText>
            <MudText><b>@_enrollment.FieldOfStudyName</b>, @EnrollmentLabels.Details(_enrollment)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@EnrollmentLabels.Faculty(_enrollment)</MudText>
        </div>
        @if (_enrollments?.Count > 1)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ChangeEnrollmentAsync">Zmień</MudButton>
        }
    </MudPaper>

    @Fields(new FormFieldsContext<TForm>(_form, _errors, EventCallback.Factory.Create(this, OnFieldChanged)))

    @if (_maxAttachments > 0)
    {
        <DraftFilesPicker Files="_files" DraftId="_autosave.Draft?.Id" EnsureDraftAsync="_autosave.EnsureDraftAsync"
                          MaxFiles="_maxAttachments" BusyChanged="busy => _filesBusy = busy"
                          Hint="@FilesHint(_form)" />
    }

    @if (_submitError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_submitError</MudAlert>
    }
    else if (_errors.Any)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">Popraw zaznaczone pola formularza.</MudAlert>
    }

    <div class="d-flex flex-wrap align-center justify-space-between gap-2">
        <MudText Typo="Typo.body2" Class="@(_autosave.SaveFailed ? "mud-error-text" : "mud-text-secondary")">
            @_autosave.Status
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Size="Size.Large"
                   Disabled="_sending || _filesBusy" OnClick="SubmitAsync">
            @(_sending ? "Wysyłanie..." : "Złóż wniosek")
        </MudButton>
    </div>
}

@code {
    // ---------- What the page of a kind gives

    [Parameter, EditorRequired]
    public string TypeCode { get; set; } = "";

    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    // Completes "wniosek ...": "o zmianę grupy" - in the messages of this page
    [Parameter, EditorRequired]
    public string About { get; set; } = "";

    [Parameter, EditorRequired]
    public RenderFragment<FormFieldsContext<TForm>> Fields { get; set; } = null!;

    // Under the file picker - it may depend on the form, e.g. a document needed for a new name
    [Parameter, EditorRequired]
    public Func<TForm, string> FilesHint { get; set; } = null!;

    // Run on a new form and on one read from a draft, e.g. an empty row ready to fill in
    [Parameter]
    public Action<TForm>? Prepare { get; set; }

    // Rules the form cannot check alone, e.g. against the student's current data
    [Parameter]
    public Func<TForm, IEnumerable<ValidationResult>>? ExtraRules { get; set; }

    // How many files the form needs - checked before sending, the server checks it again
    [Parameter]
    public Func<TForm, int>? RequiredFiles { get; set; }

    // ---------- From the address of the page

    [Parameter, EditorRequired]
    public int EnrollmentId { get; set; }

    // From "Dokończ" on "Moje wnioski": the student already chose to continue the draft
    [Parameter]
    public bool Continue { get; set; }

    // The page the form was opened from ("/new" or "/my"). Only an address inside the
    // application is used - the link could be changed by anyone.
    [Parameter]
    public string? From { get; set; }

    private string BackUrl => LocalUrl.IsLocal(From) ? From! : "my";

    // null = not loaded yet
    private IReadOnlyList<EnrollmentSummary>? _enrollments;
    private EnrollmentSummary? _enrollment;
    private string? _error;
    private bool _typeInactive;

    // This kind's applications in progress, by studies: such studies get no new one
    private Dictionary<int, MyApplicationItem> _inProgress = [];
    private MyApplicationItem? Blocking => _submitted is null ? _inProgress.GetValueOrDefault(EnrollmentId) : null;

    // Replaced by the draft's form when the student continues a draft
    private TForm _form = new();
    private readonly FormErrors _errors = new();

    // Already on the server, in the draft; submitted together with the form
    private readonly List<DraftFileInfo> _files = [];
    private int _maxAttachments;
    private bool _filesBusy;

    // After the first "Złóż wniosek" every change is checked at once
    private bool _attempted;

    // The draft, saved a moment after each change
    private DraftAutosave _autosave = null!;

    // One key per filled-in form: if the answer is lost and the student sends again,
    // the server recognises the key and returns the application it already created
    private Guid _submissionKey;
    private int _keyEnrollmentId;

    private bool _sending;
    private string? _submitError;
    private SubmittedApplication? _submitted;

    private bool HasUnsavedChanges => _submitted is null && (_autosave.HasUnsavedChanges || _filesBusy);

    // Before the first render - the page asks it about unsaved changes from the start
    protected override void OnInitialized()
    {
        Prepare?.Invoke(_form);
        _autosave = new DraftAutosave(
            () => Api.SaveDraftAsync(TypeCode, EnrollmentId, FormJson.Serialize(_form)),
            () => InvokeAsync(StateHasChanged));
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMyEnrollmentsAsync();
        if (!result.IsSuccess)
        {
            _error = result.Error.Message;
            return;
        }

        _enrollments = result.Value;

        // How many files this kind allows - an administrator can change it
        var types = await Api.GetApplicationTypesAsync();
        if (!types.IsSuccess)
        {
            _error = types.Error.Message;
            return;
        }

        // Only active kinds come back - none means the administrator has switched it off
        var type = types.Value.FirstOrDefault(t => t.Code == TypeCode);
        _typeInactive = type is null;
        _maxAttachments = type?.MaxAttachments ?? 0;

        var mine = await Api.GetMyApplicationsAsync();
        if (!mine.IsSuccess)
        {
            _error = mine.Error.Message;
            return;
        }

        _inProgress = mine.Value
            .Where(a => a.InProgress && a.TypeCode == TypeCode)
            .GroupBy(a => a.EnrollmentId)
            .ToDictionary(g => g.Key, g => g.First());

        // Nothing to continue on studies that cannot take a new application
        if (Blocking is null)
            await LoadDraftAsync();
    }

    // A draft of this kind from before: continue it, or start again and delete it
    private async Task LoadDraftAsync()
    {
        var result = await Api.GetDraftAsync(TypeCode);
        if (!result.IsSuccess || result.Value is null)
            return;

        var draft = result.Value;

        if (!Continue)
        {
            var choice = await Dialogs.ShowMessageBoxAsync(
                "Niedokończony wniosek",
                $"Masz niedokończony wniosek {About}, zapisany {DateText.Format(draft.UpdatedAt)}. " +
                "Dokończyć go? Jeśli zaczniesz od nowa, wpisane dane i dodane pliki zostaną usunięte.",
                yesText: "Dokończ", noText: "Zacznij od nowa");

            // Closing the dialog keeps the draft - nothing is deleted without a clear choice
            if (choice == false)
            {
                await Api.DeleteDraftAsync(draft.Id);
                return;
            }
        }

        _autosave.Load(draft);
        try
        {
            _form = FormJson.Deserialize<TForm>(draft.FormData);
        }
        catch (System.Text.Json.JsonException)
        {
            // Saved by an older version of the form: the files stay, the fields start empty
        }
        Prepare?.Invoke(_form);
        _files.AddRange(draft.Files);

        // Started on other studies: OnParametersSet moves the draft to the studies chosen now
    }

    // Runs after loading and again when "Zmień" puts another id in the address
    protected override void OnParametersSet()
    {
        if (_enrollments is null)
            return;

        // Only the student's own studies are on the list, so a foreign id is simply not found
        _enrollment = _enrollments.FirstOrDefault(e => e.Id == EnrollmentId);
        _error = _enrollment is null ? "Nie znaleziono wybranych studiów." : null;

        // Other studies mean another application, so it gets its own key
        if (EnrollmentId != _keyEnrollmentId)
        {
            _submissionKey = Guid.NewGuid();
            _keyEnrollmentId = EnrollmentId;
        }

        // "Zmień": the draft moves to the new studies - not to ones that cannot take it
        if (_autosave.Draft is not null && _autosave.Draft.EnrollmentId != EnrollmentId && Blocking is null)
            _autosave.Changed();
    }

    private async Task ChangeEnrollmentAsync()
    {
        var unavailable = _inProgress.ToDictionary(p => p.Key, p => $"W toku: {p.Value.Number}");
        var enrollmentId = await ChooseEnrollmentDialog.ShowAsync(Dialogs, _enrollments!, EnrollmentId,
            unavailable);

        // "from" stays, so "Wróć" still leads to where the student came from
        if (enrollmentId is not null && enrollmentId != EnrollmentId)
            Navigation.NavigateTo(ApplicationLinks.New(TypeCode, enrollmentId.Value, From));
    }

    private bool Validate() => _errors.Validate(_form, ExtraRules?.Invoke(_form));

    private void OnFieldChanged()
    {
        _submitError = null;
        if (_attempted)
            Validate();

        _autosave.Changed();
    }

    private async Task SubmitAsync()
    {
        _attempted = true;
        _submitError = null;

        if (!Validate())
            return;

        if (_files.Count < (RequiredFiles?.Invoke(_form) ?? 0))
        {
            _submitError = ApiErrorMessages.AttachmentRequired;
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Złożyć wniosek?",
            $"Wniosek {About} dla studiów: {_enrollment!.FieldOfStudyName}, " +
            $"{_enrollment.StudyLevel}." +
            (_files.Count > 0 ? $" Załączniki: {_files.Count}." : "") +
            " Po złożeniu nie można go zmienić.",
            yesText: "Złóż wniosek", cancelText: "Anuluj");

        if (confirmed != true)
            return;

        _sending = true;
        var result = await _autosave.SubmitAsync(() => Api.SubmitApplicationAsync(
            ApplicationLinks.FormRoute(TypeCode), EnrollmentId, _submissionKey, _form, _autosave.Draft?.Id));
        _sending = false;

        if (result.IsSuccess)
        {
            _submitted = result.Value;
            await Counts.RefreshAsync();
            return;
        }

        // Field errors from the server land under the same fields as the browser's own
        _errors.Set(result.Error.FieldErrors);
        _submitError = result.Error.Message;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        // "Zmień" only puts other studies in the address - the form stays filled in.
        // TargetLocation can be relative ("new/group-change/3"), so it is made absolute first.
        var target = Navigation.ToAbsoluteUri(context.TargetLocation).AbsolutePath;
        if (!HasUnsavedChanges || target.StartsWith($"/new/{ApplicationLinks.FormRoute(TypeCode)}/"))
            return;

        // Typed a moment ago: saved now instead of asking
        if (_autosave.IsDirty && !_filesBusy && await _autosave.SaveNowAsync())
            return;

        var leave = await Dialogs.ShowMessageBoxAsync(
            "Opuścić formularz?",
            _filesBusy
                ? "Pliki są jeszcze wysyłane. Jeśli wyjdziesz, mogą nie zostać dodane."
                : "Nie udało się zapisać ostatnich zmian. Jeśli wyjdziesz, mogą przepaść.",
            yesText: "Opuść", cancelText: "Zostań");

        if (leave != true)
            context.PreventNavigation();
    }

    public void Dispose() => _autosave.Dispose();
}