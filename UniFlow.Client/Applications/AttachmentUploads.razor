@* Sends the files picked in the form, one by one, right after the application was submitted *@
@inject ApiClient Api

<div class="attachment-uploads mb-4">
    <MudText Typo="Typo.subtitle2" Class="mb-1">Załączniki</MudText>

    @foreach (var upload in _uploads)
    {
        <div class="attachment-row">
            @switch (upload.Status)
            {
                case UploadStatus.Added:
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    break;
                case UploadStatus.Failed:
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" Color="Color.Error" />
                    break;
                case UploadStatus.Sending:
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="upload-progress" />
                    break;
                default:
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="mud-text-secondary" />
                    break;
            }

            <span class="attachment-name" title="@upload.File.Name">@upload.File.Name</span>

            @switch (upload.Status)
            {
                case UploadStatus.Waiting:
                    <span class="attachment-size mud-text-secondary">Czeka</span>
                    break;
                case UploadStatus.Sending:
                    <span class="attachment-size mud-text-secondary">Wysyłanie...</span>
                    break;
                case UploadStatus.Added:
                    @* target="_blank": the router lets the link through to the server *@
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="@ApiClient.AttachmentUrl(ApplicationId, upload.AttachmentId!.Value, inline: true)"
                               Target="_blank">
                        Podgląd
                    </MudButton>
                    break;
                case UploadStatus.Failed:
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               OnClick="() => RetryAsync(upload)">
                        Ponów
                    </MudButton>
                    break;
            }
        </div>

        @if (upload.Error is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-1">@upload.Error</MudText>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ApplicationId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<PickedFile> Files { get; set; } = null!;

    // True while some files are not on the server yet - the page asks before leaving
    [Parameter]
    public EventCallback<bool> UnfinishedChanged { get; set; }

    private List<AttachmentUpload> _uploads = [];

    protected override async Task OnInitializedAsync()
    {
        _uploads = Files.Select(file => new AttachmentUpload(file)).ToList();
        await UnfinishedChanged.InvokeAsync(true);

        // One after another: the server needs a moment to convert each file to PDF
        foreach (var upload in _uploads)
            await SendAsync(upload);

        await ReportAsync();
    }

    private async Task SendAsync(AttachmentUpload upload)
    {
        upload.Status = UploadStatus.Sending;
        upload.Error = null;
        StateHasChanged();

        var result = await Api.UploadAttachmentAsync(ApplicationId, upload.File);

        if (result.IsSuccess)
        {
            upload.Status = UploadStatus.Added;
            upload.AttachmentId = result.Value.Id;
        }
        else
        {
            upload.Status = UploadStatus.Failed;
            upload.Error = result.Error.Message;
        }

        StateHasChanged();
    }

    private async Task RetryAsync(AttachmentUpload upload)
    {
        await UnfinishedChanged.InvokeAsync(true);
        await SendAsync(upload);
        await ReportAsync();
    }

    private Task ReportAsync() =>
        UnfinishedChanged.InvokeAsync(_uploads.Any(u => u.Status != UploadStatus.Added));
}