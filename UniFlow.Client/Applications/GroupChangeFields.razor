@* The fields of the group change form - the same when the application is submitted and when
   it is corrected. Checking and saving stay with the page: it hears about every change. *@

@* Scope *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Zakres zmiany</MudText>
    <MudRadioGroup T="GroupChangeScope" @bind-Value="Form.Scope" @bind-Value:after="ChangedAsync"
                   Error="Errors.Has(nameof(GroupChangeForm.Scope))"
                   ErrorText="@Errors.For(nameof(GroupChangeForm.Scope))">
        <div class="d-flex flex-column">
            <MudRadio Value="GroupChangeScope.General" Color="Color.Primary">
                Wszystkie przedmioty danego rodzaju zajęć, np. grupa dziekańska albo wszystkie laboratoria
            </MudRadio>
            <MudRadio Value="GroupChangeScope.Subjects" Color="Color.Primary">
                Wybrane przedmioty
            </MudRadio>
        </div>
    </MudRadioGroup>
</MudPaper>

@* Scope = General *@
@if (Form.Scope == GroupChangeScope.General)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Grupa</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <label class="field-label" for="general-type">Rodzaj grupy</label>
                <MudSelect T="GroupType" @bind-Value="Form.GroupType" @bind-Value:after="ChangedAsync"
                           InputId="general-type" Variant="Variant.Outlined" Margin="Margin.Dense"
                           ToStringFunc="GroupTypeLabel" Placeholder="Wybierz"
                           Error="Errors.Has(nameof(GroupChangeForm.GroupType))"
                           ErrorText="@Errors.For(nameof(GroupChangeForm.GroupType))">
                    @foreach (var type in AllGroupTypes)
                    {
                        <MudSelectItem Value="type" />
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="4">
                <label class="field-label" for="general-current">Obecna<br class="phone-break" /> grupa</label>
                <MudTextField @bind-Value="Form.CurrentGroup" @bind-Value:after="ChangedAsync"
                              InputId="general-current" Placeholder="np. 3"
                              MaxLength="GroupChangeForm.MaxGroupLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(GroupChangeForm.CurrentGroup))"
                              ErrorText="@Errors.For(nameof(GroupChangeForm.CurrentGroup))" />
            </MudItem>
            <MudItem xs="6" md="4">
                <label class="field-label" for="general-requested">Wnioskowana<br class="phone-break" /> grupa</label>
                <MudTextField @bind-Value="Form.RequestedGroup" @bind-Value:after="ChangedAsync"
                              InputId="general-requested" Placeholder="np. 5"
                              MaxLength="GroupChangeForm.MaxGroupLength"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Error="Errors.Has(nameof(GroupChangeForm.RequestedGroup))"
                              ErrorText="@Errors.For(nameof(GroupChangeForm.RequestedGroup))" />
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@* Scope = Subjects *@
@if (Form.Scope == GroupChangeScope.Subjects)
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Przedmioty</MudText>

        @for (var i = 0; i < Form.Subjects.Count; i++)
        {
            // A copy for the lambdas below - "i" itself changes while the loop runs
            var index = i;
            var row = Form.Subjects[index];
            var prefix = $"{nameof(GroupChangeForm.Subjects)}[{index}].";

            <div class="subject-row">
                <div class="d-flex align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Przedmiot @(index + 1)</MudText>
                    @if (Form.Subjects.Count > 1)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                       aria-label="@($"Usuń przedmiot {index + 1}")"
                                       OnClick="() => RemoveSubjectAsync(index)" />
                    }
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="5">
                        <label class="field-label" for="subject-@index">Nazwa przedmiotu</label>
                        <MudTextField @bind-Value="row.Subject" @bind-Value:after="ChangedAsync"
                                      InputId="@($"subject-{index}")" Placeholder="np. Bazy danych"
                                      MaxLength="GroupChangeForm.MaxSubjectLength"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Error="Errors.Has(prefix + nameof(row.Subject))"
                                      ErrorText="@Errors.For(prefix + nameof(row.Subject))" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <label class="field-label" for="subject-type-@index">Rodzaj zajęć</label>
                        <MudSelect T="GroupType" @bind-Value="row.GroupType" @bind-Value:after="ChangedAsync"
                                   InputId="@($"subject-type-{index}")"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   ToStringFunc="GroupTypeLabel" Placeholder="Wybierz"
                                   Error="Errors.Has(prefix + nameof(row.GroupType))"
                                   ErrorText="@Errors.For(prefix + nameof(row.GroupType))">
                            @foreach (var type in SubjectGroupTypes)
                            {
                                <MudSelectItem Value="type" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <label class="field-label" for="subject-current-@index">Obecna<br class="phone-break" /> grupa</label>
                        <MudTextField @bind-Value="row.CurrentGroup" @bind-Value:after="ChangedAsync"
                                      InputId="@($"subject-current-{index}")" Placeholder="np. 2"
                                      MaxLength="GroupChangeForm.MaxGroupLength"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Error="Errors.Has(prefix + nameof(row.CurrentGroup))"
                                      ErrorText="@Errors.For(prefix + nameof(row.CurrentGroup))" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <label class="field-label" for="subject-requested-@index">Wnioskowana<br class="phone-break" /> grupa</label>
                        <MudTextField @bind-Value="row.RequestedGroup" @bind-Value:after="ChangedAsync"
                                      InputId="@($"subject-requested-{index}")" Placeholder="np. 4"
                                      MaxLength="GroupChangeForm.MaxGroupLength"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Error="Errors.Has(prefix + nameof(row.RequestedGroup))"
                                      ErrorText="@Errors.For(prefix + nameof(row.RequestedGroup))" />
                    </MudItem>
                </MudGrid>
            </div>
        }

        @if (Errors.Has(nameof(GroupChangeForm.Subjects)))
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-2">
                @Errors.For(nameof(GroupChangeForm.Subjects))
            </MudText>
        }

        @if (Form.Subjects.Count < GroupChangeForm.MaxSubjects)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddSubjectAsync">
                Dodaj przedmiot
            </MudButton>
        }
    </MudPaper>
}

@* Justification *@
<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <label class="field-label" for="justification">Uzasadnienie</label>
    <MudTextField @bind-Value="Form.Justification" @bind-Value:after="ChangedAsync"
                  InputId="justification" Lines="5" Immediate="true"
                  Placeholder="Napisz, dlaczego prosisz o zmianę grupy."
                  Counter="GroupChangeForm.MaxJustificationLength"
                  MaxLength="GroupChangeForm.MaxJustificationLength"
                  Variant="Variant.Outlined"
                  Error="Errors.Has(nameof(GroupChangeForm.Justification))"
                  ErrorText="@Errors.For(nameof(GroupChangeForm.Justification))" />
</MudPaper>

@code {
    private static readonly GroupType[] AllGroupTypes =
        [GroupType.Dean, GroupType.Exercises, GroupType.Laboratory, GroupType.Project];

    // A dean group is changed with the general scope, so a row does not offer it
    private static readonly GroupType[] SubjectGroupTypes =
        [GroupType.Exercises, GroupType.Laboratory, GroupType.Project];

    [Parameter, EditorRequired]
    public GroupChangeForm Form { get; set; } = null!;
    
    // One empty row is ready for the "Subjects" scope - on a new form and on one from a draft
    public static void AddEmptySubject(GroupChangeForm form)
    {
        if (form.Subjects.Count == 0)
            form.Subjects.Add(new SubjectGroupChange());
    }

    [Parameter, EditorRequired]
    public FormErrors Errors { get; set; } = null!;

    // Any change of the fields
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task ChangedAsync() => OnChanged.InvokeAsync();

    private Task AddSubjectAsync()
    {
        Form.Subjects.Add(new SubjectGroupChange());
        return ChangedAsync();
    }

    private Task RemoveSubjectAsync(int index)
    {
        Form.Subjects.RemoveAt(index);
        return ChangedAsync();
    }

    // "grupa dziekańska" -> "Grupa dziekańska"; nothing chosen yet (0) -> empty field
    private static string GroupTypeLabel(GroupType type)
    {
        if (!Enum.IsDefined(type))
            return "";

        var name = GroupTypeText.Name(type);
        return char.ToUpper(name[0]) + name[1..];
    }
}