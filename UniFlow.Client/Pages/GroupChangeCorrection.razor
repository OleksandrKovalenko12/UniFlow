@page "/applications/{Id:guid}/correct/group-change"
@attribute [Authorize(Roles = RoleNames.Student)]

<PageTitle>Poprawa wniosku - UniFlow</PageTitle>

<ApplicationCorrection TForm="GroupChangeForm" TypeCode="@ApplicationTypeCodes.GroupChange"
                       Id="Id" From="@From" Prepare="GroupChangeFields.AddEmptySubject">
    <Fields>
        <GroupChangeFields Form="context.Form" Errors="context.Errors" OnChanged="context.OnChanged" />
    </Fields>
</ApplicationCorrection>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }
}