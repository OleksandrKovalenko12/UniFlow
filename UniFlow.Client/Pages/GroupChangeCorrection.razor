@page "/applications/{Id:guid}/correct/group-change"
@attribute [Authorize(Roles = RoleNames.Student)]
@inject ApiClient Api
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Poprawa wniosku - UniFlow</PageTitle>

@* The changes are saved as a correction draft - the dean's office sees nothing until
   "Złóż ponownie". Leaving is safe; it asks only when something could not be saved yet. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="HasUnsavedChanges" />

<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
           Href="@ApplicationUrl" Class="mb-2 ml-n2">
    Wróć
</MudButton>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Poprawa wniosku @_details?.Number</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else if (_details is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!CanCorrect)
{
    @* E.g. already submitted again in another tab, or withdrawn *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Tego wniosku nie można teraz poprawić - dziekanat nie czeka na poprawę.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Href="@ApplicationUrl">
        Otwórz wniosek
    </MudButton>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <b>Dziekanat prosi o poprawę.</b>
        @if (CorrectionComment is not null)
        {
            <div class="pre-line mt-1">@CorrectionComment</div>
        }
    </MudAlert>

    @* The studies stay - the application already has its number *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Studia</MudText>
        <MudText><b>@_details.Studies.FieldOfStudyName</b>, @EnrollmentLabels.Details(_details.Studies)</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@EnrollmentLabels.Faculty(_details.Studies)</MudText>
    </MudPaper>

    <GroupChangeFields Form="_form" Errors="_errors" OnChanged="OnChanged" />

    @if (_maxAttachments > 0)
    {
        <DraftFilesPicker Files="_newFiles" DraftId="_autosave.Draft?.Id" EnsureDraftAsync="_autosave.EnsureDraftAsync"
                          MaxFiles="_maxAttachments" OtherFiles="KeptCount" BusyChanged="busy => _filesBusy = busy"
                          Hint="Usunięte pliki zostaną zarchiwizowane po ponownym złożeniu.">
            @foreach (var file in StudentFiles)
            {
                var removed = _removed.Contains(file.Id);

                <div class="@(removed ? "attachment-row archived" : "attachment-row")">
                    <MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" Class="mud-text-secondary" />
                    <span class="attachment-name" title="@file.FileName">
                        @file.FileName
                        @if (removed)
                        {
                            <span class="mud-text-secondary"> · zostanie usunięty</span>
                        }
                    </span>
                    <span class="attachment-size mud-text-secondary">@FileSizeText.Format(file.SizeBytes)</span>
                    @* target="_blank": the router lets the link through to the server *@
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="@ApiClient.AttachmentUrl(Id, file.Id, inline: true)" Target="_blank">
                        Podgląd
                    </MudButton>
                    @if (removed)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="!HasRoom"
                                   OnClick="() => Keep(file)">
                            Cofnij
                        </MudButton>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                       aria-label="@($"Usuń plik {file.FileName}")" OnClick="() => Remove(file)" />
                    }
                </div>
            }
        </DraftFilesPicker>
    }

    @if (_submitError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_submitError</MudAlert>
    }
    else if (_errors.Any)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">Popraw zaznaczone pola formularza.</MudAlert>
    }

    <div class="d-flex flex-wrap align-center justify-space-between gap-2">
        <div>
            <MudText Typo="Typo.body2" Class="@(_autosave.SaveFailed ? "mud-error-text" : "mud-text-secondary")">
                @_autosave.Status
            </MudText>
            @if (_autosave.Draft is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ml-n2"
                           Disabled="_sending || _filesBusy" OnClick="DiscardAsync">
                    Odrzuć zmiany
                </MudButton>
            }
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Size="Size.Large"
                   Disabled="_sending || _filesBusy" OnClick="ResubmitAsync">
            @(_sending ? "Wysyłanie..." : "Złóż ponownie")
        </MudButton>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }
    
    // "/" when opened from the start page - the application's "Wróć" leads back there too
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private string ApplicationUrl => ApplicationLinks.KeepFromHome($"applications/{Id}", From);

    private ApplicationDetails? _details;
    private string? _error;
    private int _maxAttachments;

    private GroupChangeForm _form = new() { Subjects = [new SubjectGroupChange()] };
    private readonly FormErrors _errors = new();
    private bool _attempted;

    // The application's files to archive, and the new ones - both wait in the correction draft
    private readonly HashSet<Guid> _removed = [];
    private readonly List<DraftFileInfo> _newFiles = [];
    private bool _filesBusy;

    private DraftAutosave _autosave = null!;

    private bool _sending;
    private string? _submitError;

    private bool CanCorrect => _details is { ForApplicant: true, Status: ApplicationState.NeedsCorrection }
        && _details.TypeCode == ApplicationTypeCodes.GroupChange;

    // What the dean's office asked for the last time it sent the application back
    private string? CorrectionComment =>
        _details?.History.LastOrDefault(h => h.To == ApplicationState.NeedsCorrection)?.Comment;

    // The student's own files still in the application (not its PDF, not archived ones)
    private IEnumerable<AttachmentInfo> StudentFiles =>
        _details!.Attachments.Where(a => !a.IsDocument && a.ArchivedAt is null);

    private int KeptCount => StudentFiles.Count(f => !_removed.Contains(f.Id));
    private bool HasRoom => KeptCount + _newFiles.Count < _maxAttachments;

    private bool HasUnsavedChanges => _autosave.HasUnsavedChanges || _filesBusy;

    // Before the first render - the page asks it about unsaved changes from the start
    protected override void OnInitialized() =>
        _autosave = new DraftAutosave(
            () => Api.SaveCorrectionAsync(Id, FormJson.Serialize(_form), _removed),
            () => InvokeAsync(StateHasChanged));

    protected override async Task OnInitializedAsync()
    {
        var details = await Api.GetApplicationAsync(Id);
        if (!details.IsSuccess)
        {
            _error = details.Error.Message;
            return;
        }

        _details = details.Value;
        if (!CanCorrect)
            return;

        // The application's own limit, the one the server checks - not the kind's current one,
        // which the administrator may have changed (or the kind switched off) since
        _maxAttachments = _details.MaxAttachments;

        var draft = await Api.GetCorrectionAsync(Id);
        if (!draft.IsSuccess)
        {
            _error = draft.Error.Message;
            return;
        }

        // Changes from before are continued without asking - it is always this application
        if (draft.Value is not null)
        {
            _autosave.Load(draft.Value);
            _removed.UnionWith(draft.Value.RemovedAttachmentIds);
            _newFiles.AddRange(draft.Value.Files);
        }

        LoadForm(draft.Value?.FormData ?? _details.FormData);
    }

    private void LoadForm(string formData)
    {
        try
        {
            _form = FormJson.Deserialize<GroupChangeForm>(formData);
        }
        catch (System.Text.Json.JsonException)
        {
            _form = FormJson.Deserialize<GroupChangeForm>(_details!.FormData);
        }

        if (_form.Subjects.Count == 0)
            _form.Subjects.Add(new SubjectGroupChange());
    }

    private void OnChanged()
    {
        _submitError = null;
        if (_attempted)
            _errors.Validate(_form);

        _autosave.Changed();
    }

    private void Remove(AttachmentInfo file)
    {
        _removed.Add(file.Id);
        _autosave.Changed();
    }

    private void Keep(AttachmentInfo file)
    {
        _removed.Remove(file.Id);
        _autosave.Changed();
    }

    // Back to the application as the dean's office sent it; new files are deleted on the server
    private async Task DiscardAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Odrzucić zmiany?",
            "Wpisane zmiany i dodane pliki zostaną usunięte. Wniosek wróci do stanu, w którym " +
            "dziekanat odesłał go do poprawy.",
            yesText: "Odrzuć", cancelText: "Anuluj");

        if (confirmed != true || _autosave.Draft is null)
            return;

        var result = await Api.DeleteDraftAsync(_autosave.Draft.Id);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        _autosave.Forget();
        _removed.Clear();
        _newFiles.Clear();
        _errors.Set(new Dictionary<string, string[]>());
        _attempted = false;
        LoadForm(_details!.FormData);
    }

    private async Task ResubmitAsync()
    {
        _attempted = true;
        _submitError = null;

        if (!_errors.Validate(_form))
            return;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Złożyć wniosek ponownie?",
            $"Wniosek {_details!.Number} wróci do dziekanatu." +
            (_removed.Count > 0 ? $" Usunięte pliki: {_removed.Count}." : "") +
            (_newFiles.Count > 0 ? $" Nowe pliki: {_newFiles.Count}." : "") +
            " Do decyzji nie można go już zmienić.",
            yesText: "Złóż ponownie", cancelText: "Anuluj");

        if (confirmed != true)
            return;

        _sending = true;
        var result = await _autosave.SubmitAsync(() => Api.ResubmitGroupChangeAsync(Id, _form));
        _sending = false;

        if (result.IsSuccess)
        {
            Snackbar.Add("Wniosek złożony ponownie.", Severity.Success);
            // replace: "wstecz" does not bring back a correction that is already sent
            Navigation.NavigateTo(ApplicationUrl, replace: true);
            return;
        }

        // Field errors from the server land under the same fields as the browser's own
        _errors.Set(result.Error.FieldErrors);
        _submitError = result.Error.Message;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasUnsavedChanges)
            return;

        // Changed a moment ago: saved now instead of asking
        if (_autosave.IsDirty && !_filesBusy && await _autosave.SaveNowAsync())
            return;

        var leave = await Dialogs.ShowMessageBoxAsync(
            "Opuścić poprawę?",
            _filesBusy
                ? "Pliki są jeszcze wysyłane. Jeśli wyjdziesz, mogą nie zostać dodane."
                : "Nie udało się zapisać ostatnich zmian. Jeśli wyjdziesz, mogą przepaść.",
            yesText: "Opuść", cancelText: "Zostań");

        if (leave != true)
            context.PreventNavigation();
    }

    public void Dispose() => _autosave.Dispose();
}