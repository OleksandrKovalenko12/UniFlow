@page "/new"
@attribute [Authorize(Roles = RoleNames.Student)]
@inject ApiClient Api
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>Nowy wniosek - UniFlow</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Nowy wniosek</MudText>
<MudText Class="mb-6 mud-text-secondary">Wybierz rodzaj wniosku, który chcesz złożyć.</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">Spróbuj ponownie</MudButton>
}
else if (_types is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_types.Count == 0)
{
    <MudAlert Severity="Severity.Info">Obecnie nie można złożyć żadnego wniosku.</MudAlert>
}
else
{
    @if (_startMessage is not null)
    {
        <MudAlert Severity="_startSeverity" Class="mb-4">@_startMessage</MudAlert>
    }

    <MudGrid>
        @foreach (var type in _types)
        {
            var blocking = BlockingFor(type.Code);

            <MudItem xs="12" sm="6" lg="4">
                <MudPaper Class="pa-4 d-flex flex-column" Elevation="0" Outlined="true" Style="height: 100%">
                    <MudText Typo="Typo.h6" GutterBottom="true">@type.Name</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@type.Description</MudText>
                    @if (blocking.Count > 0)
                    {
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Masz już ten wniosek w toku:
                            @* foreach, not for: the link's content is rendered later, when a "for"
                               counter would already be past the end of the list *@
                            @foreach (var application in blocking)
                            {
                                @(application == blocking[0] ? "" : ", ")
                                <MudLink Href="@($"applications/{application.Id}")" Typo="Typo.body2">@application.Number</MudLink>
                            }.
                            Nowy złożysz, gdy zostanie rozpatrzony albo wycofany.
                        </MudText>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-auto align-self-start"
                               Disabled="_starting || blocking.Count > 0" OnClick="() => StartAsync(type)">
                        Wypełnij wniosek
                    </MudButton>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IReadOnlyList<ApplicationTypeSummary>? _types;
    private IReadOnlyList<EnrollmentSummary> _enrollments = [];
    private IReadOnlyList<MyApplicationItem> _mine = [];
    private string? _error;

    private bool _starting;
    private string? _startMessage;
    private Severity _startSeverity;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _types = null;

        // All three at once - neither waits for the others
        var types = Api.GetApplicationTypesAsync();
        var enrollments = Api.GetMyEnrollmentsAsync();
        var mine = Api.GetMyApplicationsAsync();

        var typesResult = await types;
        var enrollmentsResult = await enrollments;
        var mineResult = await mine;

        if (!typesResult.IsSuccess)
        {
            _error = typesResult.Error.Message;
            return;
        }
        if (!enrollmentsResult.IsSuccess)
        {
            _error = enrollmentsResult.Error.Message;
            return;
        }
        if (!mineResult.IsSuccess)
        {
            _error = mineResult.Error.Message;
            return;
        }

        _enrollments = enrollmentsResult.Value;
        _mine = mineResult.Value;
        // The server lists every active kind - only those with a ready form are offered
        _types = typesResult.Value.Where(t => ApplicationLinks.HasForm(t.Code)).ToList();
    }

    // Applications of this type still in progress, by studies - one per studies at most
    private Dictionary<int, MyApplicationItem> InProgressByEnrollment(string typeCode) =>
        _mine.Where(a => a.InProgress && a.TypeCode == typeCode)
            .GroupBy(a => a.EnrollmentId)
            .ToDictionary(g => g.Key, g => g.First());

    // The type is greyed out only when every studies programme already has one in progress;
    // otherwise the student picks studies that are still free
    private List<MyApplicationItem> BlockingFor(string typeCode)
    {
        var inProgress = InProgressByEnrollment(typeCode);
        return _enrollments.Count > 0 && _enrollments.All(e => inProgress.ContainsKey(e.Id))
            ? inProgress.Values.ToList()
            : [];
    }

    // One study programme: straight to the form, more: the student chooses in a dialog
    private async Task StartAsync(ApplicationTypeSummary type)
    {
        _startMessage = null;

        var enrollments = _enrollments;
        if (enrollments.Count == 0)
        {
            ShowStartMessage("Nie masz aktywnych studiów, więc nie możesz złożyć wniosku. " +
                "Jeśli to pomyłka, skontaktuj się z dziekanatem.", Severity.Warning);
            return;
        }

        var unavailable = InProgressByEnrollment(type.Code)
            .ToDictionary(p => p.Key, p => $"W toku: {p.Value.Number}");

        _starting = true;
        var enrollmentId = enrollments.Count == 1
            ? enrollments[0].Id
            : await ChooseEnrollmentDialog.ShowAsync(Dialogs, enrollments, unavailable: unavailable);
        _starting = false;

        // "from": the form's "Wróć" brings the student back here
        if (enrollmentId is not null)
            Navigation.NavigateTo(ApplicationLinks.New(type.Code, enrollmentId.Value, "/new"));
    }

    private void ShowStartMessage(string message, Severity severity)
    {
        _startMessage = message;
        _startSeverity = severity;
    }
}