@page "/"
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ReviewListState ReviewState

<PageTitle>UniFlow</PageTitle>

@* The start page after logging in, and where the logo leads. Built around "what do I do now":
   the cases waiting for the user on the left, the numbers on the right - a section for each
   role the user has. *@

@if (_noRole)
{
    <MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Brak przypisanej roli</MudText>
    <MudText>Twoje konto nie ma jeszcze przypisanej roli. Skontaktuj się z administratorem.</MudText>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_welcome is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <div class="d-flex flex-wrap align-center gap-4 mb-6">
        <div class="flex-grow-1">
            <MudText Typo="Typo.h4" HtmlTag="h1">@Greeting, @_welcome.FirstName</MudText>
            <MudText Class="mt-1 mud-text-secondary">
                @if (_welcome.PreviousLoginAt is { } previous)
                {
                    <text>Poprzednie logowanie: @DateText.Format(previous)</text>
                }
                else
                {
                    <text>Witaj w UniFlow - elektronicznym obiegu wniosków studenckich.</text>
                }
            </MudText>
        </div>
        @* The main action of each role - the first one filled *@
        <div class="d-flex flex-wrap gap-2">
            @foreach (var (text, href, icon, index) in MainActions.Select((a, i) => (a.Text, a.Href, a.Icon, i)))
            {
                <MudButton Variant="@(index == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                           DropShadow="false" StartIcon="@icon" Href="@href">
                    @text
                </MudButton>
            }
        </div>
    </div>

    @if (_welcome.Student is { } student)
    {
        <section class="mb-6">
            @if (ShowHeaders)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Twoje wnioski</MudText>
            }

            @* What the office did since the previous login - one short line, only when something
            happened. The details are below or one click away. *@
            @if (student.Changes.Total > 0)
            {
                <div class="welcome-news mb-4">
                    <MudIcon Icon="@Icons.Material.Outlined.NotificationsActive" Size="Size.Small" Color="Color.Primary" />
                    <b>Od ostatniego logowania:</b>
                    @foreach (var change in student.Changes.Items)
                    {
                        <a href="@ApplicationLinks.FromHome($"applications/{change.ApplicationId}")" class="welcome-news-item">
                            <b>@change.Number</b> – @StudentChange(change.Status)
                        </a>
                    }
                    @if (student.Changes.Total > student.Changes.Items.Count)
                    {
                        <MudLink Href="my">i jeszcze @(student.Changes.Total - student.Changes.Items.Count)</MudLink>
                    }
                </div>
            }

            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Do zrobienia (@(student.ToCorrect.Total + student.Drafts.Total))</b></MudText>
                        @if (student.ToCorrect.Total == 0 && student.Drafts.Total == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nie masz nic do zrobienia.</MudText>
                        }
                        @foreach (var item in student.ToCorrect.Items)
                        {
                            <WelcomeRow Href="@ApplicationLinks.FromHome(ApplicationLinks.Correction(item.TypeCode, item.ApplicationId) ?? $"applications/{item.ApplicationId}")"
                                        Number="@item.Number" Title="Popraw wniosek" Action="Popraw" IsNew="IsNew(item.At)"
                                        Subtitle="@(item.Comment is null ? item.TypeName : $"„{item.Comment}”")" />
                        }
                        <WelcomeMore List="student.ToCorrect" Href="my" />
                        @foreach (var draft in student.Drafts.Items)
                        {
                            <WelcomeRow Href="@ApplicationLinks.Continue(draft, "/")" Title="@($"Dokończ: {draft.TypeName}")"
                                        Action="Dokończ"
                                        Subtitle="@($"{draft.FieldOfStudyName} · zapisany {DateText.Format(draft.UpdatedAt)}")" />
                        }
                        <WelcomeMore List="student.Drafts" Href="my" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Twoje wnioski</b></MudText>
                        <WelcomeCount Label="W toku" Value="student.InProgress" Href="my" />
                        <WelcomeCount Label="Niedokończone" Value="student.Drafts.Total" Href="my" />
                        <WelcomeCount Label="Zakończone" Value="student.Closed" Href="my/zakonczone" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_welcome.DeanOffice is { } office)
    {
        <section class="mb-6">
            @if (ShowHeaders)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Dziekanat</MudText>
            }
            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        @* First what only this employee can move on *@
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Czeka na Ciebie (@office.ForYou.Total)</b></MudText>
                        @if (office.ForYou.Total == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Nic nie czeka na Ciebie - możesz wziąć nowe wnioski.
                            </MudText>
                        }
                        @foreach (var item in office.ForYou.Items)
                        {
                           <WelcomeRow Href="@ApplicationLinks.FromHome($"applications/{item.ApplicationId}")" Number="@item.Number"
                                        Title="@(item.StudentName ?? "")"
                                            Subtitle="@(item.Status == ApplicationState.Resubmitted
                                            ? $"{item.TypeName} · poprawiony przez studenta {DateText.Format(item.At)}"
                                            : $"{item.TypeName} · w weryfikacji {Since(item.At)}")" />
                        }
                        <WelcomeMore List="office.ForYou" OnClick="() => OpenReview(ReviewTab.InReview, AssignedFilter.Me)" />

                        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1"><b>Nowe do wzięcia (@office.NewToTake.Total)</b></MudText>
                        @if (office.NewToTake.Total == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Brak nowych wniosków.</MudText>
                        }
                        @foreach (var item in office.NewToTake.Items)
                        {
                            <WelcomeRow Href="@ApplicationLinks.FromHome($"applications/{item.ApplicationId}")" Number="@item.Number"
                                        Title="@(item.StudentName ?? "")" IsNew="IsNew(item.At)"
                                        Subtitle="@($"{item.TypeName} · złożony {DateText.Day(item.At)} · czeka {Waiting(item.At)}")" />
                        }
                        <WelcomeMore List="office.NewToTake" OnClick="() => OpenReview(ReviewTab.New)" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Na Twoich wydziałach</b></MudText>
                        <WelcomeCount Label="Nowe, nikt nie prowadzi" Value="office.NewToTake.Total"
                                      OnClick="() => OpenReview(ReviewTab.New)" />
                        <WelcomeCount Label="Czekają na poprawki studenta" Value="office.WaitingForStudent"
                                      OnClick="() => OpenReview(ReviewTab.WaitingForStudent)" />
                        <WelcomeCount Label="U prodziekana" Value="office.AtViceDean"
                                      OnClick="() => OpenReview(ReviewTab.AtViceDean)" />
                        <WelcomeCount Label="Prowadzą inne osoby" Value="office.HandledByOthers"
                                      OnClick="() => OpenReview(ReviewTab.InReview, string.Empty)" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </section>
    }

    @if (_welcome.ViceDean is { } viceDean)
    {
        <section class="mb-6">
            @if (ShowHeaders)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Prodziekan</MudText>
            }
            <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Czeka na Twoją decyzję (@viceDean.Waiting.Total)</b></MudText>
                @if (viceDean.Waiting.Total == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Nic nie czeka na Twoją decyzję.</MudText>
                }
                @foreach (var item in viceDean.Waiting.Items)
                {
                    <WelcomeRow Href="@ApplicationLinks.FromHome($"applications/{item.ApplicationId}")" Number="@item.Number"
                                Title="@(item.StudentName ?? "")" IsNew="IsNew(item.At)"
                                Subtitle="@($"{item.TypeName} · przekazany {DateText.Day(item.At)} · czeka {Waiting(item.At)}")" />
                }
                <WelcomeMore List="viceDean.Waiting" OnClick="() => OpenReview(ReviewTab.AtViceDean)" />
            </MudPaper>
        </section>
    }

    @if (_welcome.Admin is { } admin)
    {
        <section class="mb-6">
            @if (ShowHeaders)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Administracja</MudText>
            }
            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Ostatnie zmiany</b></MudText>
                        @if (admin.RecentChanges.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Brak wpisów w dzienniku.</MudText>
                        }
                        @foreach (var entry in admin.RecentChanges)
                        {
                            <WelcomeRow Href="@(entry.TargetUserId is null ? "admin/log" : $"admin/accounts/{entry.TargetUserId}")"
                                        Title="@AuditTexts.Describe(entry)"
                                        Subtitle="@($"{(entry.TargetName is null ? "" : entry.TargetName + " · ")}{entry.ActorName} · {DateText.Format(entry.CreatedAt)}")" />
                        }
                        <MudLink Href="admin/log" Typo="Typo.body2" Class="d-inline-block mt-2">Cały dziennik</MudLink>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4 welcome-card" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Konta</b></MudText>
                        <WelcomeCount Label="Aktywne" Value="admin.ActiveAccounts" Href="admin/accounts?status=active" />
                        <WelcomeCount Label="Wyłączone" Value="admin.InactiveAccounts" Href="admin/accounts?status=inactive" />
                        <WelcomeCount Label="Bez własnego hasła" Value="admin.AwaitingPassword.Total" Href="admin/accounts" />
                        @* Who has not logged in yet - someone to remind *@
                        @foreach (var account in admin.AwaitingPassword.Items)
                        {
                            <WelcomeRow Href="@($"admin/accounts/{account.Id}")" Title="@account.Name"
                                        Subtitle="ma hasło tymczasowe" />
                        }
                        <WelcomeMore List="admin.AwaitingPassword" Href="admin/accounts" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </section>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private WelcomeDetails? _welcome;
    private string? _error;
    private bool _noRole;

    // In the browser's (Polish) time
    private static string Greeting => DateTime.Now.Hour is >= 5 and < 18 ? "Dzień dobry" : "Dobry wieczór";

    // One section needs no title; several (e.g. a student working in the dean's office) do
    private bool ShowHeaders =>
        new object?[] { _welcome!.Student, _welcome.DeanOffice, _welcome.ViceDean, _welcome.Admin }
            .Count(section => section is not null) > 1;

    private IEnumerable<(string Text, string Href, string Icon)> MainActions
    {
        get
        {
            if (_welcome!.Student is not null)
                yield return ("Nowy wniosek", "new", Icons.Material.Filled.NoteAdd);
            if (_welcome.DeanOffice is not null || _welcome.ViceDean is not null)
                yield return ("Wnioski do rozpatrzenia", "review", Icons.Material.Outlined.Inbox);
            if (_welcome.Admin is not null)
                yield return ("Nowe konto", "admin/accounts/new", Icons.Material.Filled.PersonAdd);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (!RoleNames.All.Any(user.IsInRole))
        {
            _noRole = true;
            return;
        }

        var result = await Api.GetWelcomeAsync();
        if (result.IsSuccess)
            _welcome = result.Value;
        else
            _error = result.Error.Message;
    }

    // The dean's office list, opened on the tab the number is about
    private void OpenReview(ReviewTab tab, string? assigned = null)
    {
        ReviewState.Tab = tab;
        if (assigned is not null)
            ReviewState.Assigned[tab] = assigned;
        Navigation.NavigateTo("review");
    }

    // Arrived since the previous login - nothing is "new" at the very first one
    private bool IsNew(DateTime at) => _welcome!.PreviousLoginAt is { } previous && at > previous;

    // What happened to the student's application, after its number: "UF/2026/0018 - zatwierdzony"
    private static string StudentChange(ApplicationState status) => status switch
    {
        ApplicationState.UnderReview => "w weryfikacji",
        ApplicationState.NeedsCorrection => "odesłany do poprawy",
        ApplicationState.ForwardedToDean => "przekazany prodziekanowi",
        ApplicationState.Approved => "zatwierdzony",
        ApplicationState.Rejected => "odrzucony",
        _ => StatusLabels.Name(status)
    };

    // "czeka od dziś", "czeka 1 dzień", "czeka 6 dni"
    private static string Waiting(DateTime sinceUtc) => (DateTime.UtcNow - sinceUtc).Days switch
    {
        0 => "od dziś",
        1 => "1 dzień",
        var days => $"{days} dni"
    };

    // "W weryfikacji od dziś", "od 1 dnia", "od 3 dni"
    private static string Since(DateTime sinceUtc) => (DateTime.UtcNow - sinceUtc).Days switch
    {
        0 => "od dziś",
        1 => "od 1 dnia",
        var days => $"od {days} dni"
    };
}