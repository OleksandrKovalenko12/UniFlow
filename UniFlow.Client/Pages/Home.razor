@page "/"
@inject NavigationManager Navigation

<PageTitle>UniFlow</PageTitle>

@if (_noRole)
{
    <MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Brak przypisanej roli</MudText>
    <MudText>Twoje konto nie ma jeszcze przypisanej roli. Skontaktuj się z administratorem.</MudText>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool _noRole;

    // "/" has no content of its own: everyone goes to the page where their work starts
    protected override async Task OnInitializedAsync()
    {
        var start = StartPage.For((await AuthState).User);

        if (start is null)
            _noRole = true;
        else
            Navigation.NavigateTo(start, replace: true);
    }
}