@page "/change-password"
@layout LoginLayout
@inject ApiClient Api
@inject CookieAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@* Only after logging in with a temporary password - the layout sends the user here and
   lets them nowhere else until it is done *@

<PageTitle>Nowe hasło - UniFlow</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1">Ustaw nowe hasło</MudText>
<MudText Class="mt-1 mb-6 mud-text-secondary">
    Logujesz się hasłem tymczasowym. Ustaw własne hasło, aby korzystać z systemu.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<EditForm Model="_model" OnSubmit="SubmitAsync">
    <label class="field-label" for="current-password">Hasło tymczasowe</label>
    <MudTextField @bind-Value="_model.CurrentPassword" @bind-Value:after="OnFieldChanged"
                  InputId="current-password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0 mb-4"
                  Error="_errors.Has(nameof(ChangePasswordRequest.CurrentPassword))"
                  ErrorText="@_errors.For(nameof(ChangePasswordRequest.CurrentPassword))" />

    <label class="field-label" for="new-password">Nowe hasło</label>
    <MudTextField @bind-Value="_model.NewPassword" @bind-Value:after="OnFieldChanged"
                  InputId="new-password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0 mb-4"
                  HelperText="@PasswordRules.Hint"
                  Error="_errors.Has(nameof(ChangePasswordRequest.NewPassword))"
                  ErrorText="@_errors.For(nameof(ChangePasswordRequest.NewPassword))" />

    <label class="field-label" for="confirm-password">Powtórz nowe hasło</label>
    <MudTextField @bind-Value="_model.ConfirmPassword" @bind-Value:after="OnFieldChanged"
                  InputId="confirm-password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0 mb-6"
                  Error="_errors.Has(nameof(ChangePasswordRequest.ConfirmPassword))"
                  ErrorText="@_errors.For(nameof(ChangePasswordRequest.ConfirmPassword))" />

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
               Size="Size.Large" FullWidth="true" DropShadow="false" Disabled="_sending">
        @(_sending ? "Zapisywanie..." : "Ustaw hasło")
    </MudButton>
</EditForm>

<MudButton Variant="Variant.Text" FullWidth="true" Class="mt-2" OnClick="LogoutAsync">Wyloguj</MudButton>

@code {
    private readonly ChangePasswordRequest _model = new();
    private readonly FormErrors _errors = new();
    private string? _error;
    private bool _sending;
    private bool _attempted;

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = null!;

    // Not linked from anywhere else: with one's own password there is nothing to do here
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        if (!user.HasClaim(c => c.Type == UniFlowClaims.MustChangePassword))
            Navigation.NavigateTo("", replace: true);
    }

    private void OnFieldChanged()
    {
        _error = null;
        if (_attempted)
            _errors.Validate(_model);
    }

    private async Task SubmitAsync()
    {
        _attempted = true;
        _error = null;

        if (!_errors.Validate(_model))
            return;

        _sending = true;
        var result = await Api.ChangePasswordAsync(_model);
        _sending = false;

        if (!result.IsSuccess)
        {
            // A wrong temporary password or a password breaking the rules - under its field
            _errors.Set(result.Error.FieldErrors);
            _error = result.Error.FieldErrors.Count > 0 ? null : result.Error.Message;
            return;
        }

        // The user without the temporary password mark - every page is open now
        AuthState.SetUser(result.Value);
        Snackbar.Add("Hasło zostało ustawione.", Severity.Success);
        Navigation.NavigateTo("", replace: true);
    }

    private async Task LogoutAsync()
    {
        if (!await AuthState.LogoutAsync())
        {
            _error = "Nie udało się wylogować. Spróbuj ponownie za chwilę.";
            return;
        }

        Navigation.NavigateTo("login", forceLoad: true);
    }
}