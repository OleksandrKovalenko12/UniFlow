@page "/applications/{Id:guid}"
@attribute [Authorize(Roles = $"{RoleNames.Student},{RoleNames.DeanOffice},{RoleNames.ViceDean}")]
@inject ApiClient Api

<PageTitle>@(_details?.Number ?? "Wniosek") - UniFlow</PageTitle>

@* Back to where this view belongs - not by role: a student working in the office has both *@
@if (_details is not null)
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@(_details.ForApplicant ? "my" : "review")" Class="mb-2 ml-n2">
        @(_details.ForApplicant ? "Wróć" : "Wnioski do rozpatrzenia")
    </MudButton>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_details is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (_details.ForApplicant && _details.Status == ApplicationState.NeedsCorrection)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <b>Dziekanat prosi o poprawę wniosku.</b>
            @if (CorrectionComment is not null)
            {
                <div class="pre-line mt-1">@CorrectionComment</div>
            }
        </MudAlert>
    }

    <ApplicationView Details="_details">
        <Actions>
            @if (_details.Actions.Count > 0)
            {
                <ReviewActionsPanel Details="_details" Decided="details => _details = details" />
            }
            @if (_details.CanWithdraw)
            {
                <StudentActionsPanel Details="_details" Changed="details => _details = details" />
            }
        </Actions>
    </ApplicationView>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ApplicationDetails? _details;
    private string? _error;
    
    // What the dean's office asked for the last time it sent the application back
    private string? CorrectionComment =>
        _details?.History.LastOrDefault(h => h.To == ApplicationState.NeedsCorrection)?.Comment;

    // Runs again when a link leads from one application to another
    protected override async Task OnParametersSetAsync()
    {
        _details = null;
        _error = null;

        var result = await Api.GetApplicationAsync(Id);
        if (result.IsSuccess)
            _details = result.Value;
        else
            _error = result.Error.Message;
    }
}