@page "/applications/{Id:guid}"
@attribute [Authorize(Roles = $"{RoleNames.Student},{RoleNames.DeanOffice},{RoleNames.ViceDean}")]
@inject ApiClient Api

<PageTitle>@(_details?.Number ?? "Wniosek") - UniFlow</PageTitle>

@* Back to where this view belongs - not by role: a student working in the office has both.
   Opened from "Inne wnioski": back to the application the employee started from, and the list
   one click away too. Opened from the start page: back there. Going back step by step is the
   browser's own back button. *@
@if (_details is not null)
{
    <div class="d-flex flex-wrap gap-2 mb-2 ml-n2">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
            Href="@BackUrl">
            @BackText
        </MudButton>
        @if (OriginId is not null)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.List" Href="@ListUrl">
                Lista wniosków
            </MudButton>
        }
    </div>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_details is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (_details.ForApplicant && _details.Status == ApplicationState.NeedsCorrection)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <b>Dziekanat prosi o poprawę wniosku.</b>
            @if (CorrectionComment is not null)
            {
                <div class="pre-line mt-1">@CorrectionComment</div>
            }
                        @if (ApplicationLinks.Correction(_details.TypeCode, Id) is { } correction)
            {
                <div class="mt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                               Href="@ApplicationLinks.KeepFromHome(correction, From)">
                        Popraw wniosek
                    </MudButton>
                </div>
            }
        </MudAlert>
    }

       <ApplicationView Details="_details" OriginId="OriginId ?? Id">
        <Actions>
            @if (_details.Actions.Count > 0)
            {
                <ReviewActionsPanel Details="_details" Decided="details => _details = details" />
            }
            @if (_details.CanWithdraw)
            {
                <StudentActionsPanel Details="_details" Changed="details => _details = details" />
            }
        </Actions>
    </ApplicationView>
}

@code {

    [Parameter]
    public Guid Id { get; set; }
   
    // The application the employee started from, when this one was opened from "Inne wnioski",
    // or "/" from the start page. Only these are used - the link could be changed by anyone.
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private Guid? OriginId =>
        LocalUrl.IsLocal(From) && From!.StartsWith("/applications/")
            && Guid.TryParse(From["/applications/".Length..], out var id) && id != Id
            ? id
            : null;


    private string BackUrl =>
        OriginId is not null ? $"applications/{OriginId}"
        : ApplicationLinks.IsFromHome(From) ? "/"
        : ListUrl;

    // "Wróć do UF/2026/0001" - the number is on this page's list of the student's applications
    private string BackText =>
        OriginId is null ? (ApplicationLinks.IsFromHome(From) ? "Wróć do strony głównej" : "Wróć")
        : _details!.OtherApplications.FirstOrDefault(a => a.Id == OriginId)?.Number is { } number
            ? $"Wróć do {number}"
            : "Poprzedni wniosek";

    private string ListUrl => _details!.ForApplicant ? "my" : "review";

    private ApplicationDetails? _details;
    private string? _error;
    
    // What the dean's office asked for the last time it sent the application back
    private string? CorrectionComment =>
        _details?.History.LastOrDefault(h => h.To == ApplicationState.NeedsCorrection)?.Comment;

    // Runs again when a link leads from one application to another
    protected override async Task OnParametersSetAsync()
    {
        _details = null;
        _error = null;

        var result = await Api.GetApplicationAsync(Id);
        if (result.IsSuccess)
            _details = result.Value;
        else
            _error = result.Error.Message;
    }
}