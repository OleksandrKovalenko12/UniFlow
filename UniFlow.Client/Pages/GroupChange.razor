@page "/new/group-change/{EnrollmentId:int}"
@attribute [Authorize(Roles = RoleNames.Student)]
@inject ApiClient Api
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Zmiana grupy zajęciowej - UniFlow</PageTitle>

@* The form is saved as a draft, so leaving is safe - it asks only when the last changes
   could not be saved yet or files are still being sent *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="HasUnsavedChanges" />

@* Back to the page the form was opened from. No "Zapisz" button: the draft saves itself,
   leaving is enough. *@
<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl" Class="mb-2 ml-n2">
    Wróć
</MudButton>

<MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Zmiana grupy zajęciowej</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="new">Wróć do listy wniosków</MudButton>
}
else if (_enrollment is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_submitted is not null)
{
    <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="0" Outlined="true" Style="text-align: center">
        <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Style="font-size: 3rem" />
        <MudText Typo="Typo.h6" Class="mt-2">Wniosek złożony</MudText>
        <MudText Class="mud-text-secondary mt-4">Numer wniosku</MudText>
        <MudLink Href="@($"applications/{_submitted.Id}")" Typo="Typo.h4" Class="mb-6">
            <b>@_submitted.Number</b>
        </MudLink>

        <div class="d-flex flex-wrap justify-center gap-2 mb-4">
            @* target="_blank" and download: the router lets these links through to the server *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Outlined.Visibility"
                       Href="@ApiClient.DocumentUrl(_submitted.Id, inline: true)" Target="_blank">
                Podgląd PDF
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Href="@ApiClient.DocumentUrl(_submitted.Id, inline: false)" download="">
                Pobierz
            </MudButton>
        </div>

        <MudText Typo="Typo.body2" Class="mud-text-secondary">Dziekanat sprawdzi wniosek.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="my" Class="mt-4">
            Moje wnioski
        </MudButton>
    </MudPaper>
}
else if (Blocking is not null)
{
    @* Reached by "wstecz" after submitting, an old link or "Zmień" - the server would refuse anyway *@
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Masz już wniosek o zmianę grupy w toku na tych studiach: <b>@Blocking.Number</b>.
        Nowy złożysz, gdy ten zostanie rozpatrzony albo wycofany.
    </MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
               Href="@($"applications/{Blocking.Id}")">
        Otwórz wniosek
    </MudButton>
}
else
{
    <MudPaper Class="pa-4 mb-4 d-flex align-center gap-4" Elevation="0" Outlined="true">
        <div class="flex-grow-1">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Studia</MudText>
            <MudText><b>@_enrollment.FieldOfStudyName</b>, @EnrollmentLabels.Details(_enrollment)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@EnrollmentLabels.Faculty(_enrollment)</MudText>
        </div>
        @if (_enrollments?.Count > 1)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ChangeEnrollmentAsync">Zmień</MudButton>
        }
    </MudPaper>

    @* Scope *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" GutterBottom="true">Zakres zmiany</MudText>
        <MudRadioGroup T="GroupChangeScope" @bind-Value="_form.Scope" @bind-Value:after="OnFieldChanged"
                       Error="_errors.Has(nameof(GroupChangeForm.Scope))"
                       ErrorText="@_errors.For(nameof(GroupChangeForm.Scope))">
            <div class="d-flex flex-column">
                <MudRadio Value="GroupChangeScope.General" Color="Color.Primary">
                    Wszystkie przedmioty danego rodzaju zajęć, np. grupa dziekańska albo wszystkie laboratoria
                </MudRadio>
                <MudRadio Value="GroupChangeScope.Subjects" Color="Color.Primary">
                    Wybrane przedmioty
                </MudRadio>
            </div>
        </MudRadioGroup>
    </MudPaper>

    @* Scope = General *@
    @if (_form.Scope == GroupChangeScope.General)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Grupa</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <label class="field-label" for="general-type">Rodzaj grupy</label>
                    <MudSelect T="GroupType" @bind-Value="_form.GroupType" @bind-Value:after="OnFieldChanged"
                               InputId="general-type" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="GroupTypeLabel" Placeholder="Wybierz"
                               Error="_errors.Has(nameof(GroupChangeForm.GroupType))"
                               ErrorText="@_errors.For(nameof(GroupChangeForm.GroupType))">
                        @foreach (var type in AllGroupTypes)
                        {
                            <MudSelectItem Value="type" />
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="4">
                    <label class="field-label" for="general-current">Obecna<br class="phone-break" /> grupa</label>
                    <MudTextField @bind-Value="_form.CurrentGroup" @bind-Value:after="OnFieldChanged"
                                  InputId="general-current" Placeholder="np. 3"
                                  MaxLength="GroupChangeForm.MaxGroupLength"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Error="_errors.Has(nameof(GroupChangeForm.CurrentGroup))"
                                  ErrorText="@_errors.For(nameof(GroupChangeForm.CurrentGroup))" />
                </MudItem>
                <MudItem xs="6" md="4">
                    <label class="field-label" for="general-requested">Wnioskowana<br class="phone-break" /> grupa</label>
                    <MudTextField @bind-Value="_form.RequestedGroup" @bind-Value:after="OnFieldChanged"
                                  InputId="general-requested" Placeholder="np. 5"
                                  MaxLength="GroupChangeForm.MaxGroupLength"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Error="_errors.Has(nameof(GroupChangeForm.RequestedGroup))"
                                  ErrorText="@_errors.For(nameof(GroupChangeForm.RequestedGroup))" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @* Scope = Subjects *@
    @if (_form.Scope == GroupChangeScope.Subjects)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6" GutterBottom="true">Przedmioty</MudText>

            @for (var i = 0; i < _form.Subjects.Count; i++)
            {
                // A copy for the lambdas below - "i" itself changes while the loop runs
                var index = i;
                var row = _form.Subjects[index];
                var prefix = $"{nameof(GroupChangeForm.Subjects)}[{index}].";

                <div class="subject-row">
                    <div class="d-flex align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Class="flex-grow-1">Przedmiot @(index + 1)</MudText>
                        @if (_form.Subjects.Count > 1)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                           aria-label="@($"Usuń przedmiot {index + 1}")"
                                           OnClick="() => RemoveSubject(index)" />
                        }
                    </div>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="5">
                            <label class="field-label" for="subject-@index">Nazwa przedmiotu</label>
                            <MudTextField @bind-Value="row.Subject" @bind-Value:after="OnFieldChanged"
                                          InputId="@($"subject-{index}")" Placeholder="np. Bazy danych"
                                          MaxLength="GroupChangeForm.MaxSubjectLength"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="_errors.Has(prefix + nameof(row.Subject))"
                                          ErrorText="@_errors.For(prefix + nameof(row.Subject))" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <label class="field-label" for="subject-type-@index">Rodzaj zajęć</label>
                            <MudSelect T="GroupType" @bind-Value="row.GroupType" @bind-Value:after="OnFieldChanged"
                                       InputId="@($"subject-type-{index}")"
                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                       ToStringFunc="GroupTypeLabel" Placeholder="Wybierz"
                                       Error="_errors.Has(prefix + nameof(row.GroupType))"
                                       ErrorText="@_errors.For(prefix + nameof(row.GroupType))">
                                @foreach (var type in SubjectGroupTypes)
                                {
                                    <MudSelectItem Value="type" />
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <label class="field-label" for="subject-current-@index">Obecna<br class="phone-break" /> grupa</label>
                            <MudTextField @bind-Value="row.CurrentGroup" @bind-Value:after="OnFieldChanged"
                                          InputId="@($"subject-current-{index}")" Placeholder="np. 2"
                                          MaxLength="GroupChangeForm.MaxGroupLength"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="_errors.Has(prefix + nameof(row.CurrentGroup))"
                                          ErrorText="@_errors.For(prefix + nameof(row.CurrentGroup))" />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <label class="field-label" for="subject-requested-@index">Wnioskowana<br class="phone-break" /> grupa</label>
                            <MudTextField @bind-Value="row.RequestedGroup" @bind-Value:after="OnFieldChanged"
                                          InputId="@($"subject-requested-{index}")" Placeholder="np. 4"
                                          MaxLength="GroupChangeForm.MaxGroupLength"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="_errors.Has(prefix + nameof(row.RequestedGroup))"
                                          ErrorText="@_errors.For(prefix + nameof(row.RequestedGroup))" />
                        </MudItem>
                    </MudGrid>
                </div>
            }

            @if (_errors.Has(nameof(GroupChangeForm.Subjects)))
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-2">
                    @_errors.For(nameof(GroupChangeForm.Subjects))
                </MudText>
            }

            @if (_form.Subjects.Count < GroupChangeForm.MaxSubjects)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddSubject">
                    Dodaj przedmiot
                </MudButton>
            }
        </MudPaper>
    }

    @* Justification *@
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <label class="field-label" for="justification">Uzasadnienie</label>
        <MudTextField @bind-Value="_form.Justification" @bind-Value:after="OnFieldChanged"
                      InputId="justification" Lines="5" Immediate="true"
                      Placeholder="Napisz, dlaczego prosisz o zmianę grupy."
                      Counter="GroupChangeForm.MaxJustificationLength"
                      MaxLength="GroupChangeForm.MaxJustificationLength"
                      Variant="Variant.Outlined"
                      Error="_errors.Has(nameof(GroupChangeForm.Justification))"
                      ErrorText="@_errors.For(nameof(GroupChangeForm.Justification))" />
    </MudPaper>

    @if (_maxAttachments > 0)
    {
        <DraftFilesPicker Files="_files" DraftId="_draft?.Id" EnsureDraftAsync="EnsureDraftAsync"
                          MaxFiles="_maxAttachments" BusyChanged="busy => _filesBusy = busy"
                          Hint="Opcjonalnie, np. zaświadczenie od pracodawcy." />
    }

    @if (_submitError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_submitError</MudAlert>
    }
    else if (_errors.Any)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">Popraw zaznaczone pola formularza.</MudAlert>
    }

    <div class="d-flex flex-wrap align-center justify-space-between gap-2">
        <MudText Typo="Typo.body2" Class="@(_saveFailed ? "mud-error-text" : "mud-text-secondary")">
            @SaveStatus
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Size="Size.Large"
                   Disabled="_sending || _filesBusy" OnClick="SubmitAsync">
            @(_sending ? "Wysyłanie..." : "Złóż wniosek")
        </MudButton>
    </div>
}

@code {
    private static readonly GroupType[] AllGroupTypes =
        [GroupType.Dean, GroupType.Exercises, GroupType.Laboratory, GroupType.Project];

    // A dean group is changed with the general scope, so a row does not offer it
    private static readonly GroupType[] SubjectGroupTypes =
        [GroupType.Exercises, GroupType.Laboratory, GroupType.Project];

    // How long after the last change the draft is saved
    private static readonly TimeSpan SaveDelay = TimeSpan.FromSeconds(1.5);

    [Parameter]
    public int EnrollmentId { get; set; }

    // From "Dokończ" on "Moje wnioski": the student already chose to continue the draft
    [SupplyParameterFromQuery(Name = "continue")]
    public bool Continue { get; set; }

    // The page the form was opened from ("/new" or "/my"). Only an address inside the
    // application is used - the link could be changed by anyone.
    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private string BackUrl => LocalUrl.IsLocal(From) ? From! : "my";

    // null = not loaded yet
    private IReadOnlyList<EnrollmentSummary>? _enrollments;
    private EnrollmentSummary? _enrollment;
    private string? _error;

    // This type's applications in progress, by studies: such studies get no new one
    private Dictionary<int, MyApplicationItem> _inProgress = [];
    private MyApplicationItem? Blocking => _submitted is null ? _inProgress.GetValueOrDefault(EnrollmentId) : null;

    // No scope chosen at the start; one empty row is ready for the "Subjects" scope.
    // Replaced by the draft's form when the student continues a draft.
    private GroupChangeForm _form = new() { Subjects = [new SubjectGroupChange()] };
    private readonly FormErrors _errors = new();

    // Already on the server, in the draft; submitted together with the form
    private readonly List<DraftFileInfo> _files = [];
    private int _maxAttachments;
    private bool _filesBusy;

    // After the first "Złóż wniosek" every change is checked at once
    private bool _attempted;

    // The draft: saved a moment after each change. _changes counts the changes, so a change
    // made while a save is on its way is not taken as saved.
    private DraftDetails? _draft;
    private bool _dirty;
    private int _changes;
    private bool _saving;
    private bool _saveFailed;
    private DateTime? _savedAt;
    private CancellationTokenSource? _saveDelay;
    private readonly SemaphoreSlim _saveLock = new(1, 1);

    // One key per filled-in form: if the answer is lost and the student sends again,
    // the server recognises the key and returns the application it already created
    private Guid _submissionKey;
    private int _keyEnrollmentId;

    private bool _sending;
    private string? _submitError;
    private SubmittedApplication? _submitted;

    private bool HasUnsavedChanges => _submitted is null && (_dirty || _saving || _filesBusy);

    private string SaveStatus =>
        _saveFailed ? "Nie udało się zapisać szkicu - spróbujemy przy następnej zmianie."
        : _saving ? "Zapisywanie..."
        : _savedAt is not null ? $"Szkic zapisany {DateText.Format(_savedAt.Value)}"
        : "";

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetMyEnrollmentsAsync();
        if (!result.IsSuccess)
        {
            _error = result.Error.Message;
            return;
        }

        _enrollments = result.Value;

        // How many files this type allows - an administrator can change it
        var types = await Api.GetApplicationTypesAsync();
        if (!types.IsSuccess)
        {
            _error = types.Error.Message;
            return;
        }

        _maxAttachments = types.Value
            .FirstOrDefault(t => t.Code == ApplicationTypeCodes.GroupChange)?.MaxAttachments ?? 0;

        var mine = await Api.GetMyApplicationsAsync();
        if (!mine.IsSuccess)
        {
            _error = mine.Error.Message;
            return;
        }

        _inProgress = mine.Value
            .Where(a => a.InProgress && a.TypeCode == ApplicationTypeCodes.GroupChange)
            .GroupBy(a => a.EnrollmentId)
            .ToDictionary(g => g.Key, g => g.First());

        // Nothing to continue on studies that cannot take a new application
        if (Blocking is null)
            await LoadDraftAsync();
    }

    // A draft of this type from before: continue it, or start again and delete it
    private async Task LoadDraftAsync()
    {
        var result = await Api.GetDraftAsync(ApplicationTypeCodes.GroupChange);
        if (!result.IsSuccess || result.Value is null)
            return;

        var draft = result.Value;

        if (!Continue)
        {
            var choice = await Dialogs.ShowMessageBoxAsync(
                "Niedokończony wniosek",
                $"Masz niedokończony wniosek o zmianę grupy, zapisany {DateText.Format(draft.UpdatedAt)}. " +
                "Dokończyć go? Jeśli zaczniesz od nowa, wpisane dane i dodane pliki zostaną usunięte.",
                yesText: "Dokończ", noText: "Zacznij od nowa");

            // Closing the dialog keeps the draft - nothing is deleted without a clear choice
            if (choice == false)
            {
                await Api.DeleteDraftAsync(draft.Id);
                return;
            }
        }

        _draft = draft;
        try
        {
            _form = FormJson.Deserialize<GroupChangeForm>(draft.FormData);
        }
        catch (System.Text.Json.JsonException)
        {
            // Saved by an older version of the form: the files stay, the fields start empty
        }
        if (_form.Subjects.Count == 0)
            _form.Subjects.Add(new SubjectGroupChange());
        _files.AddRange(draft.Files);
        _savedAt = draft.UpdatedAt;

        // Started on other studies: OnParametersSet moves the draft to the studies chosen now
    }

    // Runs after loading and again when "Zmień" puts another id in the address
    protected override void OnParametersSet()
    {
        if (_enrollments is null)
            return;

        // Only the student's own studies are on the list, so a foreign id is simply not found
        _enrollment = _enrollments.FirstOrDefault(e => e.Id == EnrollmentId);
        _error = _enrollment is null ? "Nie znaleziono wybranych studiów." : null;

        // Other studies mean another application, so it gets its own key
        if (EnrollmentId != _keyEnrollmentId)
        {
            _submissionKey = Guid.NewGuid();
            _keyEnrollmentId = EnrollmentId;
        }

        // "Zmień": the draft moves to the new studies - not to ones that cannot take it
        if (_draft is not null && _draft.EnrollmentId != EnrollmentId && Blocking is null)
            ScheduleSave();
    }

    private async Task ChangeEnrollmentAsync()
    {
        var unavailable = _inProgress.ToDictionary(p => p.Key, p => $"W toku: {p.Value.Number}");
        var enrollmentId = await ChooseEnrollmentDialog.ShowAsync(Dialogs, _enrollments!, EnrollmentId,
            unavailable);

        // "from" stays, so "Wróć" still leads to where the student came from
        if (enrollmentId is not null && enrollmentId != EnrollmentId)
            Navigation.NavigateTo($"new/group-change/{enrollmentId}" +
                (From is null ? "" : $"?from={Uri.EscapeDataString(From)}"));
    }

    // "grupa dziekańska" -> "Grupa dziekańska"; nothing chosen yet (0) -> empty field
    private static string GroupTypeLabel(GroupType type)
    {
        if (!Enum.IsDefined(type))
            return "";

        var name = GroupTypeText.Name(type);
        return char.ToUpper(name[0]) + name[1..];
    }

    private void OnFieldChanged()
    {
        _submitError = null;
        if (_attempted)
            _errors.Validate(_form);

        ScheduleSave();
    }

    // Saved a moment after the last change, not after every key
    private void ScheduleSave()
    {
        _dirty = true;
        _changes++;

        _saveDelay?.Cancel();
        _saveDelay = new CancellationTokenSource();
        _ = SaveLaterAsync(_saveDelay.Token);
    }

    private async Task SaveLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SaveDelay, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SaveNowAsync();
        await InvokeAsync(StateHasChanged);
    }

    // One save at a time; false when the server did not take it
    private async Task<bool> SaveNowAsync()
    {
        await _saveLock.WaitAsync();
        try
        {
            // Submitted in the meantime: the server has deleted the draft, it must not come back
            if (_submitted is not null)
                return true;
            if (!_dirty && _draft is not null)
                return true;

            var changes = _changes;
            _saving = true;
            var result = await Api.SaveDraftAsync(ApplicationTypeCodes.GroupChange, EnrollmentId,
                FormJson.Serialize(_form));
            _saving = false;

            if (!result.IsSuccess)
            {
                _saveFailed = true;
                return false;
            }

            _draft = result.Value;
            _savedAt = result.Value.UpdatedAt;
            _saveFailed = false;

            // Changed while saving: still dirty, the scheduled save will take it
            if (_changes == changes)
                _dirty = false;

            return true;
        }
        finally
        {
            _saveLock.Release();
        }
    }

    // A file needs a draft to go to - saved now if there is none yet
    private async Task<Guid?> EnsureDraftAsync()
    {
        if (_draft is null)
        {
            _dirty = true;
            await SaveNowAsync();
        }

        return _draft?.Id;
    }

    private void AddSubject()
    {
        _form.Subjects.Add(new SubjectGroupChange());
        OnFieldChanged();
    }

    private void RemoveSubject(int index)
    {
        _form.Subjects.RemoveAt(index);
        OnFieldChanged();
    }

    private async Task SubmitAsync()
    {
        _attempted = true;
        _submitError = null;

        if (!_errors.Validate(_form))
            return;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Złożyć wniosek?",
            $"Wniosek o zmianę grupy dla studiów: {_enrollment!.FieldOfStudyName}, " +
            $"{_enrollment.StudyLevel}." +
            (_files.Count > 0 ? $" Załączniki: {_files.Count}." : "") +
            " Po złożeniu nie można go zmienić.",
            yesText: "Złóż wniosek", cancelText: "Anuluj");

        if (confirmed != true)
            return;

        // No draft save may run alongside: after submission the draft is gone for good
        _saveDelay?.Cancel();
        await _saveLock.WaitAsync();

        _sending = true;
        ApiResult<SubmittedApplication> result;
        try
        {
            result = await Api.SubmitGroupChangeAsync(EnrollmentId, _submissionKey, _form, _draft?.Id);
            if (result.IsSuccess)
                _submitted = result.Value;
        }
        finally
        {
            _sending = false;
            _saveLock.Release();
        }

        if (result.IsSuccess)
            return;

        // Field errors from the server land under the same fields as the browser's own
        _errors.Set(result.Error.FieldErrors);
        _submitError = result.Error.Message;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        // "Zmień" only puts other studies in the address - the form stays filled in.
        // TargetLocation can be relative ("new/group-change/3"), so it is made absolute first.
        var target = Navigation.ToAbsoluteUri(context.TargetLocation).AbsolutePath;
        if (!HasUnsavedChanges || target.StartsWith("/new/group-change/"))
            return;

        // Typed a moment ago: saved now instead of asking
        if (_dirty && !_filesBusy)
        {
            _saveDelay?.Cancel();
            if (await SaveNowAsync())
                return;
        }

        var leave = await Dialogs.ShowMessageBoxAsync(
            "Opuścić formularz?",
            _filesBusy
                ? "Pliki są jeszcze wysyłane. Jeśli wyjdziesz, mogą nie zostać dodane."
                : "Nie udało się zapisać ostatnich zmian. Jeśli wyjdziesz, mogą przepaść.",
            yesText: "Opuść", cancelText: "Zostań");

        if (leave != true)
            context.PreventNavigation();
    }

    public void Dispose() => _saveDelay?.Cancel();
}