@page "/new/group-change/{EnrollmentId:int}"
@attribute [Authorize(Roles = RoleNames.Student)]

<PageTitle>Zmiana grupy zajęciowej - UniFlow</PageTitle>

@* Everything common to all kinds is in ApplicationForm - here only what is the group change's own *@
<ApplicationForm TForm="GroupChangeForm" TypeCode="@ApplicationTypeCodes.GroupChange"
                 Title="Zmiana grupy zajęciowej" About="o zmianę grupy"
                 EnrollmentId="EnrollmentId" Continue="Continue" From="@From"
                 Prepare="GroupChangeFields.AddEmptySubject"
                 FilesHint="@(_ => "Opcjonalnie, np. zaświadczenie od pracodawcy.")">
    <Fields>
        <GroupChangeFields Form="context.Form" Errors="context.Errors" OnChanged="context.OnChanged" />
    </Fields>
</ApplicationForm>

@code {
    [Parameter]
    public int EnrollmentId { get; set; }

    [SupplyParameterFromQuery(Name = "continue")]
    public bool Continue { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }
}